# Copy to .env (git-ignored) and fill in. Never commit real values.
# Reference: documentation/hosting/deployment.md#secrets-and-configuration

# --- Build time -------------------------------------------------------------
# Public Cloudflare Turnstile site key rendered into the contact form.
TURNSTILE_SITE_KEY=

# --- DreamHost origin (npm run deploy / deploy:site) ------------------------
# Server name or an SSH config alias (e.g. "samuisamui" from ~/.ssh/config).
DREAMHOST_HOST=samuisamui
# Leave empty when DREAMHOST_HOST is an SSH alias that already sets the user.
DREAMHOST_USER=
# Web directory configured in the DreamHost panel. Becomes a symlink to
# ../releases/<release> after the first deploy.
DREAMHOST_PATH=/home/samuisamui/samui-samui.de/public
# atomic (default, release directories + symlink) or direct (rsync into the
# web directory).
DREAMHOST_DEPLOY_STRATEGY=atomic
DREAMHOST_KEEP_RELEASES=5
# Optional ssh_config file passed as `ssh -F` (CI, tests).
DREAMHOST_SSH_CONFIG=

# --- Cloudflare -------------------------------------------------------------
# Deploy token: cache purge, cache/redirect rules, Worker deploy.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional; looked up by zone name when empty (needs Zone:Read).
CLOUDFLARE_ZONE_ID=
# Optional separate token for the project MCP server (.mcp.json).
CLOUDFLARE_MCP_API_TOKEN=

# --- Deploy tuning ----------------------------------------------------------
# auto | html | urls | everything | none
DEPLOY_PURGE_MODE=auto
# More changed HTML pages than this -> one "html" tag purge instead of URLs.
CACHE_PURGE_HTML_URL_LIMIT=500

# --- Worker secrets ---------------------------------------------------------
# Not read from here in production: set them once with
#   npx wrangler secret put RESEND_API_KEY   (and the others below)
# `npm run dev:worker` reads them from this file for local testing.
RESEND_API_KEY=
TURNSTILE_SECRET=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_BCC=
