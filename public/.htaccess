# Origin configuration for samui-samui.de on DreamHost (Apache 2.4).
#
# DreamHost only serves the static Astro build. Visitors reach it through the
# Cloudflare proxy, which caches HTML and assets at the edge. /api/* never
# reaches this server: a Cloudflare Worker route answers it.
# Architecture and reasoning: documentation/hosting/architecture.md
# Cache policy and TTL reasoning: documentation/hosting/caching.md
#
# This file is copied from public/ into dist/ by `astro build` and deployed
# with the rest of the site, so it is versioned with the content it serves.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# MIME types Apache does not always know.
AddType application/manifest+json .webmanifest
AddType application/wasm .wasm
AddType font/woff2 .woff2
AddType image/avif .avif

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Historical redirects, formerly [[redirects]] in netlify.toml. These are
  # SEO-relevant URLs from the long-lived archive -- do not drop any of them
  # without review. On Netlify, files generated by Astro's `redirects` config
  # (src/data/redirects.json) shadowed these rules and answered with a 200
  # meta-refresh page; here the rewrite runs first, so crawlers get a real
  # 301 to the same destination.
  RewriteRule ^taglines/?$ /iumas/ [R=301,L]
  RewriteRule ^tags/?$ /archiv/themen/ [R=301,L]
  RewriteRule ^tags/(.+)$ /archiv/themen/$1 [R=301,L]
  # Taxonomies moved under /archiv/ (documentation/content/taxonomies.md);
  # `leute` was renamed to `personen` in the same change.
  RewriteRule ^themen/?$ /archiv/themen/ [R=301,L]
  RewriteRule ^themen/(.+)$ /archiv/themen/$1 [R=301,L]
  RewriteRule ^leute/?$ /archiv/personen/ [R=301,L]
  RewriteRule ^leute/(.+)$ /archiv/personen/$1 [R=301,L]
  RewriteRule ^orte/?$ /archiv/orte/ [R=301,L]
  RewriteRule ^orte/(.+)$ /archiv/orte/$1 [R=301,L]
  RewriteRule ^ereignisse/?$ /archiv/ereignisse/ [R=301,L]
  RewriteRule ^ereignisse/(.+)$ /archiv/ereignisse/$1 [R=301,L]
</IfModule>

# DreamHost enables mod_expires server-wide (HTML 10 minutes, assets 30
# days). Its extra Cache-Control and Expires headers would contradict the
# policy below and let browsers keep HTML after a deploy.
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
  # Remove anything the server configuration added outside this file, and
  # DreamHost's "Vary: User-Agent" (every user agent would be a separate
  # cache variant in browsers and intermediate caches).
  Header unset Expires
  Header unset Cache-Control
  Header edit Vary "(^|,)\s*User-Agent\s*(,|$)" "$1$2"
  Header edit Vary "^,+|,+$" ""
  Header edit Vary ",,+" ","
  Header unset Vary "expr=resp('Vary') == ''"

  # Security headers, formerly [[headers]] for "/*" in netlify.toml. The CSP
  # resource audit behind this policy (issues #709, #722, #1227): Matomo
  # (analytics.dnbhub.xyz), Giscus (giscus.app), YouTube/Vimeo embeds,
  # Cloudflare Turnstile (challenges.cloudflare.com), Pagefind's WASM index
  # ('wasm-unsafe-eval'), and MapLibre/OpenFreeMap (tiles.openfreemap.org).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://giscus.app https://analytics.dnbhub.xyz; style-src 'self' 'unsafe-inline' https://giscus.app; img-src 'self' data: blob: https:; font-src 'self'; frame-src https://www.youtube-nocookie.com https://player.vimeo.com https://giscus.app https://challenges.cloudflare.com; connect-src 'self' https://analytics.dnbhub.xyz https://tiles.openfreemap.org; worker-src 'self'; child-src blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Giscus loads the site's theme CSS and webfonts cross-origin
  # (documentation/components/giscus-comments.md).
  Header always set Access-Control-Allow-Origin "https://giscus.app" "expr=%{REQUEST_URI} =~ m#^/assets/(styles/giscus-samui-[^/]+\.css|webfonts/)#"

  # --- Cache policy (documentation/hosting/caching.md) ----------------------
  #
  # Two audiences, two headers:
  # * Cache-Control is what browsers see.
  # * Cloudflare-CDN-Cache-Control is read only by Cloudflare (it takes
  #   precedence over Cache-Control there and is not forwarded to visitors),
  #   so the edge can keep a page much longer than a browser does.
  # * Cache-Tag groups responses for purging; Cloudflare strips it too.
  #
  # Order matters: later rules override earlier ones for the same response.

  # Default for non-fingerprinted static files (images, fonts, feeds,
  # Pagefind index, robots/humans.txt): one day in the browser, 30 days at
  # the edge. Deploys purge changed files of this kind by URL.
  Header always set Cache-Control "public, max-age=86400"
  Header always set Cloudflare-CDN-Cache-Control "public, max-age=2592000"
  Header always set Cache-Tag "static"

  # Fingerprinted build output. Astro writes it flat into /assets/ (build.assets
  # in astro.config.ts) with a content hash in the file name, so a changed file
  # always gets a new URL. Files from public/assets/ live in sub-directories
  # and keep the default policy above.
  Header always set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/assets/[^/]+$#"
  Header always set Cloudflare-CDN-Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/assets/[^/]+$#"
  Header always set Cache-Tag "immutable" "expr=%{REQUEST_URI} =~ m#^/assets/[^/]+$#"

  # Giscus theme CSS keeps the short lifetime it had on Netlify.
  Header always set Cache-Control "public, max-age=3600" "expr=%{REQUEST_URI} =~ m#^/assets/styles/giscus-samui-#"

  # HTML documents. Browsers revalidate on every navigation (cheap: Cloudflare
  # answers the conditional request from its cache). Cloudflare keeps the page
  # for HTML_EDGE_TTL; every deploy purges the "html" tag or the changed URLs,
  # so the TTL only bounds how often unchanged pages are re-fetched from
  # DreamHost and how long a missed purge could show stale content.
  #
  # HTML_EDGE_TTL -- current phase (heavy site-wide development): 86400 (1 day).
  # Steady state (mostly content deploys with selective purges): raise to
  # 604800 (7 days). stale-while-revalidate hides DreamHost latency on expiry;
  # stale-if-error keeps pages up for a week if DreamHost is down.
  Header always set Cache-Control "public, max-age=0, must-revalidate" "expr=%{CONTENT_TYPE} =~ m#^text/html#"
  Header always set Cloudflare-CDN-Cache-Control "public, max-age=86400, stale-while-revalidate=3600, stale-if-error=604800" "expr=%{CONTENT_TYPE} =~ m#^text/html#"
  Header always set Cache-Tag "html" "expr=%{CONTENT_TYPE} =~ m#^text/html#"

  # Redirects (legacy 301s above, mod_dir's trailing-slash 301s): stable, so
  # an hour in the browser and a day at the edge. Tagged "html" so a broad
  # HTML purge also refreshes them.
  Header always set Cache-Control "public, max-age=3600" "expr=%{REQUEST_STATUS} -ge 300 && %{REQUEST_STATUS} -lt 400"
  Header always set Cloudflare-CDN-Cache-Control "public, max-age=86400" "expr=%{REQUEST_STATUS} -ge 300 && %{REQUEST_STATUS} -lt 400"
  Header always set Cache-Tag "html" "expr=%{REQUEST_STATUS} -ge 300 && %{REQUEST_STATUS} -lt 400"

  # Never keep error responses long: a URL that 404s today may be published
  # tomorrow, and a purge of the new page URL should not be the only thing
  # standing between visitors and the article.
  Header always set Cache-Control "public, max-age=0, must-revalidate" "expr=%{REQUEST_STATUS} -ge 400"
  Header always set Cloudflare-CDN-Cache-Control "public, max-age=300" "expr=%{REQUEST_STATUS} -ge 400"
</IfModule>
