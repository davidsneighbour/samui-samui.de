{
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/mdx": "5.0.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "6.4.8",
    "sharp": "0.34.5",
    "typescript": "5.9.3"
  },
  "scripts": {
    "astro": "astro",
    "astro:check": "astro check",
    "build": "astro check && astro build --verbose",
    "dev": "astro dev --verbose",
    "dev:verbose": "DEBUG_FRONTMATTER=true astro dev --verbose",
    "preview": "astro preview",
    "upgrade": "npx @astrojs/upgrade"
  }
}
