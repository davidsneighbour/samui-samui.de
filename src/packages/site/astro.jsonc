{
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.1",
    "sharp": "0.35.3",
    "typescript": "5.9.3"
  },
  "scripts": {
    "astro": "astro",
    "build": "npm run validate && astro build --verbose",
    "dev": "astro dev --verbose",
    "dev:verbose": "DEBUG_FRONTMATTER=true astro dev --verbose",
    "preview": "astro preview",
    "upgrade": "npx @astrojs/upgrade",
    "validate": "npm run validate:content && npm run validate:taxonomies",
    "validate:content": "astro check",
    "validate:taxonomies": "node src/scripts/validate-taxonomies.ts"
  }
}
