{
  "dependencies": {
    "@dnbhq/tsconfig": "0.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.1",
    "sharp": "0.35.4",
    "typescript": "6.0.3"
  },
  "scripts": {
    "astro": "astro",
    "build": "npm run validate && astro build && npm run audit:ahrefs",
    "build:verbose": "npm run validate && astro build --verbose && npm run audit:ahrefs",
    "dev": "node src/scripts/dev.ts",
    "dev:docs": "node src/scripts/documentation-server.ts",
    "dev:site": "astro dev",
    "dev:site:verbose": "astro dev --verbose",
    "dev:verbose": "DEBUG_FRONTMATTER=true ASTRO_SITE_SCRIPT=dev:site:verbose node src/scripts/dev.ts",
    "preview": "astro preview",
    "upgrade": "npx @astrojs/upgrade",
    "validate": "npm run validate:content && npm run validate:taxonomies",
    "validate:content": "astro check",
    "validate:taxonomies": "node src/scripts/validate-taxonomies.ts"
  }
}
