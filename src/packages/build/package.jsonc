{
  "devDependencies": {
    "fixpack": "4.0.0",
    "vite": "8.4.0"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "overrides": {
    "@opentelemetry/api": "1.8.0",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    },
    "esbuild": "0.28.1",
    "get-uri": {
      "basic-ftp": "^6.2.1"
    },
    "js-yaml": "5.4.3",
    "katex": "0.18.2",
    "markdown-it": "15.0.3",
    "markdownlint-rule-title-case-style": {
      "markdownlint": "^0.41.1"
    },
    "release-it": {
      "undici": "^7.29.1"
    },
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "tar": "7.5.22",
    "toml": "4.2.0"
  },
  "lint-staged": {
    "{package.json,src/packages/**/*.jsonc}": [
      "node src/packages/generate-package.ts --check"
    ]
  },
  "scripts": {
    "compile:fixpack": "wireit",
    "compile:package": "wireit",
    "compile:package:install": "wireit",
    "compile:package:update": "wireit",
    "validate:package": "node src/packages/generate-package.ts --check"
  },
  "wireit": {
    "compile:fixpack": {
      "command": "fixpack --config ci/.fixpackrc.json || true && fixpack --config ci/.fixpackrc.json || true"
    },
    "compile:package": {
      "command": "npm run compile:package:install",
      "dependencies": [
        "compile:package:run"
      ],
      "files": [
        "./src/packages/**/*.jsonc"
      ]
    },
    "compile:package:install": {
      "command": "npm install",
      "dependencies": [
        "compile:fixpack"
      ]
    },
    "compile:package:run": {
      "command": "node ./src/packages/generate-package.ts"
    },
    "compile:package:update": {
      "command": "node ./src/packages/update-package.ts"
    }
  }
}
