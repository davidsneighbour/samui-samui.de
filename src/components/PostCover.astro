---
import { Picture } from 'astro:assets';
import Vimeo from '@components/Vimeo.astro';
import Youtube from '@components/Youtube.astro';
import type { ResolvedPostCover } from '@utils/covers';

interface Props {
  captionClass?: string;
  cover: ResolvedPostCover;
  eager?: boolean;
  figureClass?: string;
  imageClass?: string;
  sizes?: string;
}

const {
  captionClass = 'mt-2 text-center text-xs text-muted-foreground',
  cover,
  eager = false,
  figureClass = 'm-0',
  imageClass = 'block h-auto w-full',
  sizes = '(min-width: 896px) 896px, 100vw',
} = Astro.props as Props;

const loading = eager ? 'eager' : 'lazy';
---

<figure class={figureClass}>
  {cover.type === 'image' && (
      cover.optimized && typeof cover.src !== 'string' ? (
      <Picture
        src={cover.src}
        alt={cover.alt}
        formats={['avif', 'webp']}
        widths={[640, 750, 828, 1080, 1280]}
        sizes={sizes}
        loading={loading}
        decoding="async"
        class={imageClass}
      />
      ) : (
      <img
        src={typeof cover.src === 'string' ? cover.src : cover.src.src}
        alt={cover.alt}
        loading={loading}
        decoding="async"
        class={imageClass}
      />
      )
    )}
  {cover.type === 'youtube' && (
    <Youtube
      videoid={cover.videoid}
      title={cover.title}
      params={cover.params}
      autoload={cover.autoload}
      autoplay={cover.autoplay}
      class={imageClass}
    />
  )}
  {cover.type === 'vimeo' && (
    <Vimeo
      videoid={cover.videoid}
      title={cover.title}
      startAt={cover.startAt}
      hash={cover.hash}
      autoload={cover.autoload}
      autoplay={cover.autoplay}
      class={imageClass}
    />
  )}
  {cover.caption && <figcaption class={captionClass}>{cover.caption}</figcaption>}
</figure>
