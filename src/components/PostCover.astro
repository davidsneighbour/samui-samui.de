---
import { Picture } from 'astro:assets';
import LegacyImagePresentation from '@components/LegacyImagePresentation.astro';
import Vimeo from '@components/Vimeo.astro';
import Youtube from '@components/Youtube.astro';
import type { ResolvedPostCover } from '@utils/covers';
import { classifyImagePresentation } from '@utils/legacy-images/classify';
import { defaultLegacyImageConfig } from '@utils/legacy-images/config';

interface Props {
  captionClass?: string;
  cover: ResolvedPostCover;
  eager?: boolean;
  figureClass?: string;
  imageClass?: string;
  /**
   * The width this cover is expected to render at, e.g. the post content
   * column. When omitted, the legacy-image classifier never runs and the
   * cover renders exactly as before -- opt in per call site (hero/featured
   * covers) rather than at cropped thumbnail card sizes.
   */
  presentationWidth?: number;
  sizes?: string;
  videoClass?: string;
}

const {
  captionClass = 'mt-2 text-center text-xs text-muted-foreground',
  cover,
  eager = false,
  figureClass = 'm-0',
  imageClass = 'block h-auto w-full',
  presentationWidth,
  sizes = '(min-width: 896px) 896px, 100vw',
  videoClass = imageClass,
} = Astro.props as Props;

const loading = eager ? 'eager' : 'lazy';

const presentationMode =
  cover.type === 'image' &&
  presentationWidth &&
  cover.intrinsicWidth &&
  cover.intrinsicHeight
    ? classifyImagePresentation(
        {
          expectedRenderedWidth: presentationWidth,
          intrinsicHeight: cover.intrinsicHeight,
          intrinsicWidth: cover.intrinsicWidth,
          override: cover.legacyOverride,
        },
        defaultLegacyImageConfig,
      )
    : 'standard';
---

<figure class={figureClass}>
  {cover.type === 'image' && (
      presentationMode === 'legacy' || presentationMode === 'thumbnail' ? (
      <LegacyImagePresentation
        src={cover.src}
        alt={cover.alt}
        mode={presentationMode}
        intrinsicWidth={cover.intrinsicWidth as number}
        intrinsicHeight={cover.intrinsicHeight as number}
        expectedRenderedWidth={presentationWidth as number}
        fsPath={cover.fsPath}
        loading={loading}
        class={imageClass}
      />
      ) : cover.optimized && typeof cover.src !== 'string' ? (
      <Picture
        src={cover.src}
        alt={cover.alt}
        formats={['avif', 'webp']}
        widths={[640, 750, 828, 1080, 1280]}
        width={1280}
        sizes={sizes}
        loading={loading}
        decoding="async"
        class={imageClass}
      />
      ) : (
      <img
        src={typeof cover.src === 'string' ? cover.src : cover.src.src}
        alt={cover.alt}
        loading={loading}
        decoding="async"
        class={imageClass}
      />
      )
    )}
  {cover.type === 'youtube' && (
    <Youtube
      videoid={cover.videoid}
      title={cover.title}
      params={cover.params}
      autoload={cover.autoload}
      autoplay={cover.autoplay}
      class={videoClass}
    />
  )}
  {cover.type === 'vimeo' && (
    <Vimeo
      videoid={cover.videoid}
      title={cover.title}
      startAt={cover.startAt}
      hash={cover.hash}
      autoload={cover.autoload}
      autoplay={cover.autoplay}
      class={videoClass}
    />
  )}
  {cover.caption && <figcaption class={captionClass}>{cover.caption}</figcaption>}
</figure>
