---
import 'maplibre-gl/dist/maplibre-gl.css';
import '@styles/theme.css';
import FallbackImage from '@assets/blog-placeholder-1.jpg';
import Analytics from '@components/Analytics.astro';
import setup from '@data/setup.json';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | undefined;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;
---

<script is:inline>
  (() => {
    const storageKey = 'samui-theme';
    const darkThemeColor = '#290e1c';
    const lightThemeColor = '#f8f3e6';
    const root = document.documentElement;

    const getStoredTheme = () => {
      try {
        const stored = localStorage.getItem(storageKey);
        return stored === 'light' ? 'light' : 'dark';
      } catch {
        return 'dark';
      }
    };

    const updateThemeColor = (theme) => {
      const themeColor = document.querySelector('meta[name="theme-color"]');
      themeColor?.setAttribute(
        'content',
        theme === 'dark' ? darkThemeColor : lightThemeColor,
      );
    };

    const applyTheme = (theme, persist = true) => {
      const nextTheme = theme === 'light' ? 'light' : 'dark';
      const isDark = nextTheme === 'dark';

      root.classList.toggle('dark', isDark);
      root.dataset.theme = nextTheme;
      root.style.colorScheme = nextTheme;
      updateThemeColor(nextTheme);
      if (document.readyState === 'loading') {
        document.addEventListener(
          'DOMContentLoaded',
          () => updateThemeColor(nextTheme),
          { once: true },
        );
      }

      if (persist) {
        try {
          localStorage.setItem(storageKey, nextTheme);
        } catch {
          // Ignore unavailable storage; the class update still applies.
        }
      }

      document.dispatchEvent(
        new CustomEvent('samui-theme-change', {
          detail: { theme: nextTheme },
        }),
      );
    };

    window.SamuiTheme = {
      getTheme: () => (root.classList.contains('dark') ? 'dark' : 'light'),
      setTheme: (theme) => applyTheme(theme),
      toggleTheme: () =>
        applyTheme(root.classList.contains('dark') ? 'light' : 'dark'),
    };

    applyTheme(getStoredTheme(), false);
  })();
</script>

<!-- Global Metadata -->
<meta charset="utf-8">
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<link
  rel="icon"
  type="image/x-icon"
  href="/images/favicon/favicon.ico"
>
<link
  rel="sitemap"
  href="/sitemap-index.xml"
>
<link
  rel="alternate"
  type="application/rss+xml"
  title={setup.title}
  href={new URL("rss.xml", Astro.site)}
>
<link
  rel="search"
  type="application/opensearchdescription+xml"
  title={setup.title}
  href="/opensearch.xml"
>
<link
  rel="manifest"
  href="/images/favicon/site.webmanifest"
>
<meta
  name="theme-color"
  content="#290e1c"
>
<meta
  name="color-scheme"
  content="dark light"
>
<meta
  name="generator"
  content={Astro.generator}
>

<!-- Canonical URL -->
<link
  rel="canonical"
  href={canonicalURL}
>

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta
  name="title"
  content={title}
>
<meta
  name="description"
  content={description}
>

<!-- Open Graph / Facebook -->
<meta
  property="og:type"
  content="website"
>
<meta
  property="og:url"
  content={Astro.url}
>
<meta
  property="og:title"
  content={title}
>
<meta
  property="og:description"
  content={description}
>
<meta
  property="og:image"
  content={new URL(image.src, Astro.url)}
>

<!-- Twitter -->
<meta
  property="twitter:card"
  content="summary_large_image"
>
<meta
  property="twitter:url"
  content={Astro.url}
>
<meta
  property="twitter:title"
  content={title}
>
<meta
  property="twitter:description"
  content={description}
>
<meta
  property="twitter:image"
  content={new URL(image.src, Astro.url)}
>

{import.meta.env.PROD && <Analytics />}
