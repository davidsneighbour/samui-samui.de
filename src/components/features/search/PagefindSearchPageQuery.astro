<script>
  import { getInstanceManager } from '@pagefind/component-ui';
  import { trackPagefindSearch } from '@scripts/analytics/track-pagefind-search';

  trackPagefindSearch(getInstanceManager().getInstance('search-page'));

  window.addEventListener('DOMContentLoaded', () => {
    const query = new URLSearchParams(window.location.search).get('q');
    if (!query) return;

    const instance = getInstanceManager().getInstance('search-page');
    instance.triggerSearch(query);
  });
</script>
