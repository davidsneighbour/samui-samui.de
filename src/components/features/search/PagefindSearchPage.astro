---
import PagefindSearchPageQuery from '@components/features/search/PagefindSearchPageQuery.astro';
---

<section class="pagefind-search-page">
  <pagefind-config
    instance="search-page"
    bundle-path="/pagefind/"
    base-url="/"
    preload
  ></pagefind-config>
  <pagefind-input
    instance="search-page"
    placeholder="Archiv durchsuchen"
  ></pagefind-input>
  <div class="pagefind-search-page__filters">
    <pagefind-filter-dropdown
      instance="search-page"
      filter="Year"
      label="Jahr"
      sort="count-desc"
      single-select
    ></pagefind-filter-dropdown>
    <pagefind-filter-dropdown
      instance="search-page"
      filter="Thema"
      label="Thema"
      sort="alphabetical"
    ></pagefind-filter-dropdown>
  </div>
  <pagefind-summary
    instance="search-page"
    default-message="Suchbegriff eingeben."
  ></pagefind-summary>
  <pagefind-results instance="search-page"></pagefind-results>
</section>
<PagefindSearchPageQuery />

<!-- data-astro-rerun: the query-string bridge must run after every
     view-transition navigation to /suche/?q=..., not only after a hard load. -->
<script
  is:inline
  data-astro-rerun
>
  (() => {
    const shouldFocus = window.matchMedia(
      '(hover: hover) and (pointer: fine)',
    ).matches;
    if (!shouldFocus) return;

    const searchInput = document.querySelector(
      'pagefind-input[instance="search-page"]',
    );
    if (!(searchInput instanceof HTMLElement)) return;

    const focusSearch = () => {
      const target =
        searchInput.shadowRoot?.querySelector('input') ?? searchInput;
      if (target instanceof HTMLElement) {
        target.focus({ preventScroll: true });
      }
    };

    if (customElements.get('pagefind-input')) {
      requestAnimationFrame(focusSearch);
      return;
    }

    customElements.whenDefined('pagefind-input').then(() => {
      requestAnimationFrame(focusSearch);
    });
  })();
</script>
