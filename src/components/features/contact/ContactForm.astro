---
import { buttonVariants } from '@components/ui/button.astro';
import FormMessage from '@components/ui/form-message.astro';
import Input from '@components/ui/input.astro';
import Label from '@components/ui/label.astro';
import Textarea from '@components/ui/textarea.astro';
import {
  MailQuestionMark,
  MessageSquareWarning,
  Send,
  UserPen,
} from '@lucide/astro';
import { cn } from '@utils/cn';

// Read at build/render time only; the site key is meant to be public and is
// rendered into the cf-turnstile widget below. The secret never leaves the
// Netlify Function (see src/netlify/functions/contact.mjs).
const turnstileSiteKey = import.meta.env['TURNSTILE_SITE_KEY'];
---

{turnstileSiteKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
  )}

<form
  method="POST"
  action="/.netlify/functions/contact"
  data-contact-form
>
  <p hidden>
    <label>Nicht ausfüllen: <input name="bot-field"></label>
  </p>
  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <div class="grid gap-2">
      <Label for="contact-name">Name</Label>
      <div class="relative">
        <UserPen
          aria-hidden="true"
          class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted-foreground"
        />
        <Input
          id="contact-name"
          name="name"
          autocomplete="name"
          required
          aria-describedby="contact-name-error"
          class="pl-9"
        />
      </div>
      <FormMessage
        id="contact-name-error"
        data-field-error
      />
    </div>
    <div class="grid gap-2">
      <Label for="contact-email">Email</Label>
      <div class="relative">
        <MailQuestionMark
          aria-hidden="true"
          class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted-foreground"
        />
        <Input
          id="contact-email"
          type="email"
          name="email"
          autocomplete="email"
          required
          aria-describedby="contact-email-error"
          class="pl-9"
        />
      </div>
      <FormMessage
        id="contact-email-error"
        data-field-error
      />
    </div>
  </div>
  <div class="mt-4 grid gap-2">
    <Label for="contact-message">Nachricht</Label>
    <div class="relative">
      <MessageSquareWarning
        aria-hidden="true"
        class="pointer-events-none absolute top-3 left-3 size-4 text-muted-foreground"
      />
      <Textarea
        id="contact-message"
        name="message"
        rows="8"
        required
        aria-describedby="contact-message-error"
        class="pl-9"
      />
    </div>
    <FormMessage
      id="contact-message-error"
      data-field-error
    />
  </div>
  {turnstileSiteKey && (
      <p class="mt-4">
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-action="turnstile-spin-v2"
          data-callback="onTurnstileVerified"
          data-expired-callback="onTurnstileUnverified"
          data-error-callback="onTurnstileUnverified"
        >
        </div>
      </p>
    )}
  <div
    class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
  >
    {turnstileSiteKey && (
        <p class="turnstile-disclaimer">
          Diese Seite ist durch Cloudflare Turnstile geschützt, es gelten die{' '}
          <a href="https://www.cloudflare.com/privacypolicy/">Datenschutzerklärung</a>{' '}
          und die{' '}
          <a href="https://www.cloudflare.com/website-terms/">Nutzungsbedingungen</a>{' '}
          von Cloudflare.
        </p>
      )}
    <button
      type="submit"
      class={cn(buttonVariants(), 'sm:ml-auto')}
      disabled={turnstileSiteKey ? true : undefined}
    >
      <Send
        aria-hidden="true"
        class="size-4"
      />
      Absenden
    </button>
  </div>
  <p
    role="status"
    data-form-status
    hidden
  >
    <span data-form-status-text></span>
  </p>
</form>

<style>
  .turnstile-disclaimer {
    font-size: 0.8em;
  }
  .turnstile-disclaimer a {
    color: var(--color-link);
    text-decoration-line: underline;
    text-underline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .turnstile-disclaimer a:hover {
      text-decoration-line: none;
    }
  }

  [data-form-status] {
    margin-block-start: 1rem;
    padding: 0.5em 1em;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) - 4px);
    background: var(--color-muted);
    color: var(--color-card-foreground);
  }

  [data-form-status].success {
    border-color: var(--color-primary);
  }

  [data-form-status].error {
    border-left-color: var(--color-link);
  }
</style>

<script is:inline>
  const form = document.querySelector('[data-contact-form]');
  const status = form?.querySelector('[data-form-status]');
  const statusText = status?.querySelector('[data-form-status-text]');

  // Turnstile calls these by name once the widget resolves. The submit
  // button starts disabled (see the `disabled` attribute above) so a user
  // can't submit before a token exists, which otherwise looks like a normal
  // click that silently gets rejected as "suspicious" server-side.
  window.onTurnstileVerified = function () {
    form?.querySelector("button[type='submit']")?.removeAttribute('disabled');
  };
  window.onTurnstileUnverified = function () {
    form
      ?.querySelector("button[type='submit']")
      ?.setAttribute('disabled', 'true');
  };

  function fieldErrorMessage(field) {
    const validity = field.validity;
    if (validity.valueMissing) return 'Dieses Feld ist erforderlich.';
    if (validity.typeMismatch && field.type === 'email') {
      return 'Bitte gib eine gültige E-Mail-Adresse ein.';
    }
    return field.validationMessage;
  }

  function fieldErrorElement(field) {
    const describedBy = field.getAttribute('aria-describedby');
    return describedBy ? document.getElementById(describedBy) : null;
  }

  function showFieldError(field) {
    const message = fieldErrorElement(field);
    if (message) message.textContent = fieldErrorMessage(field);
    field.setAttribute('aria-invalid', 'true');
  }

  function clearFieldError(field) {
    const message = fieldErrorElement(field);
    if (message) message.textContent = '';
    field.removeAttribute('aria-invalid');
  }

  const validatedFields = form?.querySelectorAll('[aria-describedby]') ?? [];
  for (const field of validatedFields) {
    field.addEventListener('invalid', (event) => {
      event.preventDefault();
      showFieldError(field);
    });
    field.addEventListener('input', () => {
      if (field.validity.valid) clearFieldError(field);
    });
  }

  function showStatus(variant, message) {
    if (
      !(status instanceof HTMLElement) ||
      !(statusText instanceof HTMLElement)
    ) {
      return;
    }
    status.className = variant;
    statusText.textContent = message;
    status.hidden = false;
    window.SamuiSound?.play(variant === 'success' ? 'success' : 'error');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (
      !(form instanceof HTMLFormElement) ||
      !(status instanceof HTMLElement)
    ) {
      return;
    }

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const submitButton = form.querySelector("button[type='submit']");
    submitButton?.setAttribute('disabled', 'true');
    window.SamuiSound?.play('loading');
    status.hidden = true;
    if (statusText instanceof HTMLElement) {
      statusText.textContent = '';
    }

    try {
      const formData = new FormData(form);

      const response = await fetch(form.action, {
        body: formData,
        headers: { Accept: 'application/json' },
        method: form.method,
      });
      const result = await response.json();

      showStatus(response.ok ? 'success' : 'error', result.message);

      if (response.ok) {
        form.reset();
      }
    } catch {
      showStatus('error', 'Die Nachricht konnte nicht gesendet werden.');
    } finally {
      submitButton?.removeAttribute('disabled');
    }
  });
</script>
