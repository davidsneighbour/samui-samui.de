---
import { Moon } from 'lucide';
import MorphIcon from 'morphicons/astro';
---

<button
  type="button"
  class="theme-toggle relative inline-flex size-11 shrink-0 items-center justify-center overflow-hidden rounded-(--radius) text-foreground/85 transition-[background-color,color,scale] duration-150 ease-out hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background active:scale-[0.96]"
  data-theme-toggle
  aria-label="Helles Farbschema aktivieren"
  aria-pressed="true"
  title="Helles Farbschema aktivieren"
  data-cuelume-toggle="bloom"
>
  <MorphIcon
    icon={Moon}
    class="theme-toggle__icon size-5"
    size={20}
    strokeWidth={2}
    reducedMotion="user"
  />
</button>

<script>
  import { Moon, Sun } from 'lucide';
  import type { MorphIconElement } from 'morphicons/element';

  declare global {
    interface Window {
      SamuiThemeToggleBound?: boolean;
      SamuiTheme?: {
        getTheme: () => 'dark' | 'light';
        setTheme: (theme: 'dark' | 'light') => void;
        toggleTheme: () => void;
      };
    }
  }

  const updateButton = (button: HTMLButtonElement) => {
    const icon = button.querySelector<MorphIconElement>('morph-icon');
    const isDark = document.documentElement.classList.contains('dark');
    const label = isDark
      ? 'Helles Farbschema aktivieren'
      : 'Dunkles Farbschema aktivieren';

    button.dataset['theme'] = isDark ? 'dark' : 'light';
    button.setAttribute('aria-pressed', String(isDark));
    button.setAttribute('aria-label', label);
    button.title = label;
    const themeIcon = isDark ? Moon : Sun;
    if (typeof icon?.morphTo === 'function') {
      icon.morphTo(themeIcon);
    } else if (icon) {
      icon.icon = themeIcon;
    }
  };

  const updateButtons = () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>(
      '[data-theme-toggle]',
    )) {
      updateButton(button);
    }
  };

  if (!window.SamuiThemeToggleBound) {
    window.SamuiThemeToggleBound = true;
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest<HTMLButtonElement>('[data-theme-toggle]');
      if (!button) return;

      window.SamuiTheme?.toggleTheme();
      updateButtons();
    });
    document.addEventListener('samui-theme-change', updateButtons);
    document.addEventListener('astro:page-load', updateButtons);
  }

  updateButtons();
</script>

<style>
  .theme-toggle__icon {
    display: inline-flex;
    color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle__icon :global(svg) {
      transition: none;
    }
  }
</style>
