---
import Analytics from '@components/features/analytics/Analytics.astro';
import WeatherWidget from '@components/features/weather/WeatherWidget.astro';
import Tooltip from '@components/ui/tooltip.astro';
import { Copyright, Volume2, VolumeX } from '@lucide/astro';

interface Props {
  // Opt out of the weather widget for pages that intentionally render no
  // normal site chrome (see documentation/features/weather-widget.md#placement),
  // e.g. 404.astro. Every other shared layout renders it by default.
  hideWeather?: boolean | undefined;
}

const { hideWeather = false } = Astro.props as Props;
const today = new Date();
---

{!hideWeather && <WeatherWidget />}

<footer class="bg-background px-4 py-10 text-center text-sm text-foreground/70">
  <Tooltip
    id="sound-toggle-tooltip"
    content="Klangeffekte deaktivieren"
    class="mb-4"
    interactive
    placement="top"
  >
    <button
      slot="trigger"
      type="button"
      class="sound-toggle inline-flex size-11 shrink-0 items-center justify-center overflow-hidden rounded-(--radius) text-foreground/75 transition-[background-color,color,scale] duration-150 ease-out hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background active:scale-[0.96]"
      data-sound-toggle
      aria-label="Klangeffekte deaktivieren"
      aria-pressed="true"
      aria-describedby="sound-toggle-tooltip"
    >
      <span
        class="sound-toggle__icon sound-toggle__icon--on absolute inset-0 inline-flex items-center justify-center"
        aria-hidden="true"
      >
        <Volume2 class="size-5" />
      </span>
      <span
        class="sound-toggle__icon sound-toggle__icon--off inline-flex items-center justify-center"
        aria-hidden="true"
      >
        <VolumeX class="size-5" />
      </span>
    </button>
  </Tooltip>
  <p class="m-0 inline-flex flex-wrap items-center justify-center gap-1.5">
    <Copyright
      aria-hidden="true"
      class="size-4 shrink-0"
    />
    <span class="sr-only">Copyright</span>
    <span>
      2005 bis {today.getFullYear()} Patrick Kollitsch. Alle Rechte vorbehalten.
    </span>
  </p>
  <nav
    aria-label="Rechtliches"
    class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-1"
  >
    <a
      href="/kleingedrucktes/impressum/"
      class="hover:text-link hover:underline"
    >
      Impressum
    </a>
    <a
      href="/kleingedrucktes/datenschutzerklaerung/"
      class="hover:text-link hover:underline"
    >
      Datenschutzerklärung
    </a>
    <a
      href="/kleingedrucktes/kommentarrichtlinien/"
      class="hover:text-link hover:underline"
    >
      Kommentarrichtlinien
    </a>
  </nav>
</footer>

<!-- data-astro-rerun: rebinds the click listener on every view-transition
     navigation; otherwise a page swapped in after the first load gets a
     button with no handler attached. -->
<script
  is:inline
  data-astro-rerun
>
  (() => {
    const button = document.querySelector('[data-sound-toggle]');
    if (!(button instanceof HTMLButtonElement)) return;

    const tooltipContent = document.getElementById('sound-toggle-tooltip');

    const updateButton = () => {
      const enabled = window.SamuiSound?.getEnabled() ?? true;
      const label = enabled
        ? 'Klangeffekte deaktivieren'
        : 'Klangeffekte aktivieren';

      button.dataset.sound = enabled ? 'on' : 'off';
      button.setAttribute('aria-pressed', String(enabled));
      button.setAttribute('aria-label', label);
      if (tooltipContent) tooltipContent.textContent = label;
    };

    button.addEventListener('click', () => {
      window.SamuiSound?.toggleEnabled();
      updateButton();
    });
    document.addEventListener('samui-sound-change', updateButton);
    updateButton();
  })();
</script>

<style>
  .sound-toggle {
    position: relative;
  }

  .sound-toggle__icon {
    opacity: 0;
    transform: scale(0.25);
    filter: blur(4px);
    transition-property: opacity, transform, filter;
    transition-duration: 180ms;
    transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }

  .sound-toggle[data-sound="on"] .sound-toggle__icon--on,
  .sound-toggle[data-sound="off"] .sound-toggle__icon--off {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .sound-toggle__icon {
      transition: none;
    }
  }
</style>

{import.meta.env.PROD && <Analytics />}

<div
  class="w-full"
  aria-hidden="true"
>
  <img
    src="/assets/images/garuda-footer-dark.webp"
    alt=""
    width="2600"
    height="468"
    loading="lazy"
    decoding="async"
    class="hidden w-full dark:block"
  >
  <img
    src="/assets/images/garuda-footer-light.webp"
    alt=""
    width="2600"
    height="468"
    loading="lazy"
    decoding="async"
    class="block w-full dark:hidden"
  >
</div>
