---
import { ChevronRight } from '@lucide/astro';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string | undefined;
}

const { items, class: className } = Astro.props as Props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    item: new URL(item.href, Astro.site).toString(),
    name: item.label,
    position: index + 1,
  })),
};
---

<nav
  aria-label="Breadcrumb"
  class:list={["text-sm text-muted-foreground", className]}
>
  <ol class="flex flex-wrap items-center gap-1">
    {items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li class="flex items-center gap-1">
            {index > 0 && <ChevronRight aria-hidden="true" class="size-3.5 shrink-0" />}
            {isLast ? (
              <span class="text-card-foreground" aria-current="page">
                {item.label}
              </span>
            ) : (
              <a href={item.href} class="hover:text-link hover:underline">
                {item.label}
              </a>
            )}
          </li>
        );
      })}
  </ol>
</nav>
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(jsonLd)}
/>
