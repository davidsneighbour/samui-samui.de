---
import ConstructionBanner from '@components/ConstructionBanner.astro';
import HeaderLink from '@components/HeaderLink.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import setup from '@data/setup.json';
import { AtSign, Binoculars, Birdhouse, Landmark, Tags } from '@lucide/astro';

const navLinkClass =
  'px-1.5 py-1 text-foreground/85 hover:text-primary sm:px-2';
---

<a
  href="#main"
  class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-50 focus-visible:rounded-(--radius) focus-visible:bg-background focus-visible:px-4 focus-visible:py-2 focus-visible:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
>
  Zum Inhalt springen
</a>
<ConstructionBanner />
<header class="border-b border-foreground/10 bg-background">
  <div class="masthead">
    <a
      href="/"
      class="masthead__link"
    >
      <span class="masthead__name">{setup.title}</span>
      <span class="masthead__tagline">{setup.description}</span>
    </a>
  </div>
  <nav
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-x-4 gap-y-2 px-4 py-4"
  >
    <div class="flex flex-wrap items-center gap-x-0.5 text-sm">
      <HeaderLink
        href="/"
        class={navLinkClass}
      >
        <Birdhouse
          aria-hidden="true"
          class="size-4 shrink-0"
        />
        <span>Startseite</span>
      </HeaderLink>
      <HeaderLink
        href="/archiv/"
        class={navLinkClass}
      >
        <Landmark
          aria-hidden="true"
          class="size-4 shrink-0"
        />
        <span>Archiv</span>
      </HeaderLink>
      <HeaderLink
        href="/themen/"
        class={navLinkClass}
      >
        <Tags
          aria-hidden="true"
          class="size-4 shrink-0"
        />
        <span>Themen</span>
      </HeaderLink>
      <HeaderLink
        href="/suche/"
        class={navLinkClass}
      >
        <Binoculars
          aria-hidden="true"
          class="size-4 shrink-0"
        />
        <span>Suchen</span>
      </HeaderLink>
      <HeaderLink
        href="/kontakt/"
        class={navLinkClass}
      >
        <AtSign
          aria-hidden="true"
          class="size-4 shrink-0"
        />
        <span>Kontakt</span>
      </HeaderLink>
    </div>
    <ThemeToggle />
  </nav>
</header>

<style>
  /* Recreates the original theme's #topheader masthead: the site name is
                             rendered with the header photo clipped into the text (background-clip:
                             text + transparent fill), and the font-size steps follow the old
                             Bootstrap breakpoints (576/768/992/1200/1400) rather than Tailwind's,
                             so the scale matches the live site exactly. */
  .masthead {
    margin: 0 auto;
    max-width: 100%;
    padding: 1.5rem 0.75rem 0;
    text-align: center;
    text-transform: uppercase;
  }

  @media (min-width: 576px) {
    .masthead {
      max-width: 540px;
    }
  }

  @media (min-width: 768px) {
    .masthead {
      max-width: 720px;
    }
  }

  @media (min-width: 992px) {
    .masthead {
      max-width: 960px;
    }
  }

  @media (min-width: 1200px) {
    .masthead {
      max-width: 1140px;
    }
  }

  @media (min-width: 1400px) {
    .masthead {
      max-width: 1320px;
    }
  }

  .masthead__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .masthead__name {
    display: block;
    font-family: var(--font-sans);
    font-size: 40px;
    font-weight: 900;
    line-height: 0.85;
    text-decoration: none;
    color: transparent;
    background-image: url("/assets/header/header-201906.jpg");
    background-position: 0 40%;
    background-size: cover;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .masthead__tagline {
    display: block;
    margin-top: 1rem;
    padding: 4px 0;
    border-top: 1px solid var(--color-primary);
    color: var(--masthead-tagline);
    font-size: 1.85vw;
    text-align: center;
    font-weight: 900;
  }

  @media (min-width: 576px) {
    .masthead__name {
      font-size: 68px;
    }
    .masthead__tagline {
      padding: 2px 0;
    }
  }

  @media (min-width: 768px) {
    .masthead__name {
      font-size: 92px;
    }
  }

  @media (min-width: 992px) {
    .masthead__name {
      font-size: 125px;
    }
    .masthead__tagline {
      padding: 5px 0;
    }
  }

  @media (min-width: 1200px) {
    .masthead__name {
      font-size: 149px;
    }
  }

  @media (min-width: 1400px) {
    .masthead__name {
      font-size: 172px;
    }
  }
</style>
