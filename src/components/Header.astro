---
import ConstructionBanner from '@components/ConstructionBanner.astro';
import HeaderLink from '@components/HeaderLink.astro';
import setup from '@data/setup.json';

const navLinkClass =
  'px-1.5 py-1 text-foreground/85 hover:text-primary sm:px-2';
---

<ConstructionBanner />
<header class="border-b border-foreground/10 bg-background">
  <nav
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-4"
  >
    <a
      href="/"
      class="text-xl font-black tracking-tight text-foreground sm:text-2xl"
    >
      {setup.title}
    </a>
    <div class="flex flex-wrap items-center gap-x-0.5 text-sm">
      <HeaderLink
        href="/"
        class={navLinkClass}
        >Startseite</HeaderLink
      >
      <HeaderLink
        href="/archiv/"
        class={navLinkClass}
        >Archiv</HeaderLink
      >
      <HeaderLink
        href="/suche/"
        class={navLinkClass}
        >Suchen</HeaderLink
      >
      <HeaderLink
        href="/kontakt/"
        class={navLinkClass}
        >Kontakt</HeaderLink
      >
    </div>
  </nav>
</header>
