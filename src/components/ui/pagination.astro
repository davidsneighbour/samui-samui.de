---
import {
  ArrowLeftToLine,
  ArrowRightToLine,
  Ellipsis,
  Pencil,
} from '@lucide/astro';
import { cn } from '@utils/cn';

interface Props {
  basePath?: string | undefined;
  placement?: 'bottom' | 'top' | undefined;
  previousHref?: string | undefined;
  nextHref?: string | undefined;
  pageNumber: number;
  totalPages: number;
}

type PageItem =
  | { type: 'page'; page: number }
  | { type: 'ellipsis'; key: string };

const normalizeBasePath = (path = '') => {
  const trimmed = path.replace(/\/+$/, '');
  if (!trimmed || trimmed === '/') return '';
  return trimmed.startsWith('/') ? trimmed : `/${trimmed}`;
};

const ensureLeadingSlash = (path: string) =>
  path.startsWith('/') ? path : `/${path}`;

const getPageItems = (currentPage: number, pagesTotal: number): PageItem[] => {
  const pages = new Set<number>();

  pages.add(1);
  pages.add(pagesTotal);

  for (
    let page = Math.max(1, currentPage - 1);
    page <= Math.min(pagesTotal, currentPage + 1);
    page += 1
  ) {
    pages.add(page);
  }

  if (currentPage <= 3) {
    for (let page = 1; page <= Math.min(3, pagesTotal); page += 1) {
      pages.add(page);
    }
  }

  if (currentPage >= pagesTotal - 2) {
    for (
      let page = Math.max(1, pagesTotal - 2);
      page <= pagesTotal;
      page += 1
    ) {
      pages.add(page);
    }
  }

  return [...pages]
    .filter((page) => page >= 1 && page <= pagesTotal)
    .sort((a, b) => a - b)
    .reduce<PageItem[]>((items, page) => {
      const previous = items.at(-1);

      if (previous?.type === 'page' && page - previous.page > 1) {
        if (page - previous.page === 2) {
          items.push({ page: previous.page + 1, type: 'page' });
        } else {
          items.push({ key: `${previous.page}-${page}`, type: 'ellipsis' });
        }
      }

      items.push({ page, type: 'page' });
      return items;
    }, []);
};

const {
  basePath: rawBasePath,
  placement = 'bottom',
  previousHref,
  nextHref,
  pageNumber,
  totalPages,
} = Astro.props as Props;

const basePath = normalizeBasePath(rawBasePath);
const pageHref = (page: number) =>
  ensureLeadingSlash(
    page === 1 ? basePath || '/' : `${basePath}/seite/${page}/`,
  );
const pageItems = getPageItems(pageNumber, totalPages);

// `before:-inset-1` pads the visually-compact 36px controls out to a 44px
// invisible hit area; adjacent controls sit `gap-2` (8px) apart, so the 4px
// expansion on each side meets its neighbor's without overlapping it.
const controlClass =
  "relative inline-flex h-9 min-w-9 items-center justify-center gap-2 whitespace-nowrap rounded-[calc(var(--radius)-4px)] px-3 text-sm font-medium transition-colors before:absolute before:-inset-1 before:content-[''] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2";
const linkClass =
  'text-card-foreground hover:bg-accent hover:text-accent-foreground';
const activeClass = 'bg-primary text-primary-foreground hover:bg-primary/90';
const disabledClass = 'pointer-events-none opacity-45';
const paginationId = `pagination-page-current-${placement}-${pageNumber}`;
const navLabel =
  placement === 'top' ? 'Seitennavigation oben' : 'Seitennavigation unten';
const navClass = cn(
  'mx-auto max-w-4xl px-4',
  placement === 'top' ? 'mb-8' : 'mt-8',
);
---

<nav
  class={navClass}
  aria-label={navLabel}
>
  <ul
    class="flex flex-wrap items-center justify-center gap-2 rounded-(--radius) bg-card px-4 py-4 text-card-foreground sm:px-6"
  >
    <li>
      {previousHref ? (
          <a
            href={previousHref}
            class={cn(controlClass, linkClass)}
            aria-label="Zu neueren Beiträgen"
          >
            <ArrowLeftToLine
              aria-hidden="true"
              class="size-4"
            />
            <span class="hidden sm:inline">Neuere</span>
          </a>
        ) : (
          <span
            class={cn(controlClass, disabledClass)}
            aria-disabled="true"
          >
            <ArrowLeftToLine
              aria-hidden="true"
              class="size-4"
            />
            <span class="hidden sm:inline">Neuere</span>
          </span>
        )}
    </li>

    {pageItems.map((item) => (
        <li>
          {item.type === 'ellipsis' ? (
              <span
                class="inline-flex h-9 min-w-9 items-center justify-center px-2 text-sm text-muted-foreground"
                aria-hidden="true"
              >
                <Ellipsis class="size-4" />
              </span>
            ) : item.page === pageNumber ? (
              <form
                class="inline-flex h-9 items-center"
                data-pagination-current
                data-base-path={basePath || '/'}
                data-current-page={pageNumber}
                data-total-pages={totalPages}
                aria-label="Aktuelle Seitennummer bearbeiten"
                transition:name={`pagination-active-${placement}`}
              >
                <button
                  class={cn(controlClass, activeClass, 'min-w-14 pr-2.5')}
                  type="button"
                  data-pagination-current-trigger
                  aria-current="page"
                  aria-label={`Aktuelle Seite ${item.page} bearbeiten`}
                  title={`Seite ${item.page} bearbeiten`}
                >
                  <span>{item.page}</span>
                  <Pencil
                    aria-hidden="true"
                    class="size-3.5 opacity-60"
                  />
                </button>
                <label class="sr-only" for={paginationId}>
                  Seitennummer
                </label>
                <input
                  id={paginationId}
                  class="h-9 w-16 rounded-[calc(var(--radius)-4px)] border border-primary/80 bg-primary px-3 text-center text-sm font-medium tabular-nums text-primary-foreground transition-[border-color,box-shadow] placeholder:text-primary-foreground/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                  data-pagination-current-input
                  inputmode="numeric"
                  maxlength={String(totalPages).length}
                  name="page"
                  pattern="[0-9]*"
                  title={`Seite 1 bis ${totalPages}`}
                  type="text"
                  value={String(pageNumber)}
                  hidden
                />
              </form>
            ) : (
              <a
                href={pageHref(item.page)}
                class={cn(controlClass, linkClass)}
                aria-label={`Seite ${item.page}`}
              >
                {item.page}
              </a>
            )}
        </li>
      ))}

    <li>
      {nextHref ? (
          <a
            href={nextHref}
            class={cn(controlClass, linkClass)}
            aria-label="Zu älteren Beiträgen"
          >
            <span class="hidden sm:inline">Ältere</span>
            <ArrowRightToLine
              aria-hidden="true"
              class="size-4"
            />
          </a>
        ) : (
          <span
            class={cn(controlClass, disabledClass)}
            aria-disabled="true"
          >
            <span class="hidden sm:inline">Ältere</span>
            <ArrowRightToLine
              aria-hidden="true"
              class="size-4"
            />
          </span>
        )}
    </li>
  </ul>
</nav>

<script
  is:inline
  data-astro-rerun
>
  (() => {
    const pagination = document.currentScript?.previousElementSibling;
    if (pagination instanceof HTMLElement) {
      pagination
        .querySelectorAll('[data-pagination-current]')
        .forEach((form) => {
          if (!(form instanceof HTMLFormElement)) return;

          const input = form.querySelector('[data-pagination-current-input]');
          if (!(input instanceof HTMLInputElement)) return;

          const trigger = form.querySelector(
            '[data-pagination-current-trigger]',
          );
          if (!(trigger instanceof HTMLButtonElement)) return;

          const currentPage = form.dataset.currentPage ?? '';
          const totalPages = Number.parseInt(form.dataset.totalPages ?? '', 10);
          const basePath = form.dataset.basePath ?? '/';
          if (!Number.isFinite(totalPages)) return;

          const closeEditor = () => {
            input.value = currentPage;
            input.hidden = true;
            trigger.hidden = false;
          };

          const openEditor = () => {
            trigger.hidden = true;
            input.hidden = false;
            input.value = currentPage;
            window.requestAnimationFrame(() => {
              input.focus();
              input.select();
            });
          };

          trigger.addEventListener('click', openEditor);

          input.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
              event.preventDefault();
              closeEditor();
              trigger.focus();
            }
          });

          input.addEventListener('blur', () => {
            if (input.hidden) return;
            closeEditor();
          });

          form.addEventListener('submit', (event) => {
            event.preventDefault();

            if (!/^\d+$/.test(input.value)) return;

            const requestedPage = Number.parseInt(input.value, 10);
            const page = Math.min(Math.max(requestedPage, 1), totalPages);
            const normalizedBasePath =
              basePath === '/' ? '' : basePath.replace(/\/+$/, '');
            const href =
              page === 1
                ? normalizedBasePath || '/'
                : `${normalizedBasePath}/seite/${page}/`;

            window.location.assign(href);
          });
        });
    }
  })();
</script>
