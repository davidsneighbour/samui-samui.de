---
import { cn } from '@utils/cn';
import { TOOLTIP_CONTROLLER_SCRIPT } from '@utils/tooltip/controller';

interface Props {
  content: string;
  id?: string | undefined;
  label?: string | undefined;
  class?: string | undefined;
  triggerClass?: string | undefined;
  contentClass?: string | undefined;
  // Set when the slotted trigger is already an interactive, focusable
  // element (e.g. a <button>) that manages its own focus styling and
  // accessible name. Skips the wrapper's own tabindex/aria-label so the
  // control doesn't get a redundant tab stop.
  interactive?: boolean | undefined;
  placement?: 'top' | 'bottom' | undefined;
}

const {
  content,
  id = `tooltip-${crypto.randomUUID()}`,
  label = content,
  class: className,
  triggerClass,
  contentClass,
  interactive = false,
  placement = 'bottom',
} = Astro.props as Props;
const triggerA11yAttrs = interactive
  ? {}
  : { 'aria-describedby': id, 'aria-label': label, tabindex: '0' };
---

<span
  class={cn('tooltip inline-flex', className)}
  data-tooltip
  data-tooltip-placement={placement}
>
  <span
    class={cn(
      'tooltip__trigger inline-flex items-center justify-center',
      !interactive &&
        'rounded-[calc(var(--radius)-4px)] leading-none text-muted-foreground transition-[color,scale] duration-150 ease-out hover:text-card-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card active:scale-[0.96] [&>svg]:block',
      triggerClass,
    )}
    data-tooltip-trigger
    {...triggerA11yAttrs}
  >
    <slot name="trigger" />
  </span>
  <span
    id={id}
    class={cn(
      'tooltip__content fixed z-50 w-max rounded-[calc(var(--radius)-4px)] border border-border bg-muted px-3 py-2 text-center text-xs leading-snug text-card-foreground opacity-0 shadow-md transition-[opacity,transform] duration-150 ease-out',
      contentClass,
    )}
    role="tooltip"
    aria-hidden="true"
    data-tooltip-content
  >
    {content}
  </span>
</span>

<script
  is:inline
  set:html={TOOLTIP_CONTROLLER_SCRIPT}
/>
