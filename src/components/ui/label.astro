---
import { cn } from '@utils/cn';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'label'>, 'class'> {
  class?: string | undefined;
}

const { class: className, ...rest } = Astro.props as Props;
const classes = cn(
  'text-sm leading-none font-medium select-none peer-disabled:cursor-not-allowed peer-disabled:opacity-50',
  className,
);
---

<label
  class={classes}
  {...rest}
>
  <slot />
</label>
