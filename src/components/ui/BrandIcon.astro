---
/**
 * Brand logo from the `simple-icons` package, rendered as inline SVG at build
 * time. No request leaves the site. Lucide has no brand logos, so use this
 * only for brands; every other icon comes from `@lucide/astro`.
 *
 * The logo is decorative by default (`aria-hidden`); give the surrounding
 * link or button its accessible name.
 */
import type { HTMLAttributes } from 'astro/types';
import type { SimpleIcon } from 'simple-icons';

interface Props extends HTMLAttributes<'svg'> {
  icon: SimpleIcon;
}

const { icon, 'aria-hidden': ariaHidden = 'true', ...attributes } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="currentColor"
  aria-hidden={ariaHidden}
  data-icon={`simple-icons:${icon.slug}`}
  {...attributes}
>
  <path d={icon.path} />
</svg>
