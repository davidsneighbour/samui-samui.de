---
// Read at build/render time only; the site key is meant to be public and is
// embedded in the recaptcha/api.js URL below. The secret never leaves the
// Netlify Function (see netlify/functions/contact.mjs).
const recaptchaSiteKey = import.meta.env.RECAPTCHA_SITE_KEY;
---

{recaptchaSiteKey && (
    <script
      is:inline
      src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`}
    ></script>
  )}

<form
  method="POST"
  action="/.netlify/functions/contact"
  data-contact-form
>
  <p hidden>
    <label>Nicht ausfüllen: <input name="bot-field"></label>
  </p>
  <p>
    <label for="contact-name">Name</label><br>
    <input
      id="contact-name"
      name="name"
      autocomplete="name"
      required
    >
  </p>
  <p>
    <label for="contact-email">Email</label><br>
    <input
      id="contact-email"
      type="email"
      name="email"
      autocomplete="email"
      required
    >
  </p>
  <p>
    <label for="contact-message">Nachricht</label><br>
    <textarea
      id="contact-message"
      name="message"
      rows="8"
      required
    ></textarea>
  </p>
  {recaptchaSiteKey && (
      <p class="recaptcha-disclaimer">
        Diese Seite ist durch reCAPTCHA geschützt, es gelten die{' '}
        <a href="https://policies.google.com/privacy">Datenschutzerklärung</a>{' '}
        und die{' '}
        <a href="https://policies.google.com/terms">Nutzungsbedingungen</a>{' '}
        von Google.
      </p>
    )}
  <p>
    <button type="submit">Absenden</button>
  </p>
  <p
    role="status"
    data-form-status
    hidden
  >
    <span data-form-status-text></span>
  </p>
</form>

<style>
  .recaptcha-disclaimer {
    font-size: 0.8em;
  }
  [data-form-status] {
    padding: 0.5em 1em;
    border-radius: 4px;
  }
  [data-form-status].success {
    background: #dcfce7;
    color: #166534;
  }
  [data-form-status].error {
    background: #fee2e2;
    color: #991b1b;
  }
</style>

<script
  is:inline
  define:vars={{ recaptchaSiteKey }}
>
  const RECAPTCHA_ACTION = 'contact';

  const form = document.querySelector('[data-contact-form]');
  const status = form?.querySelector('[data-form-status]');
  const statusText = status?.querySelector('[data-form-status-text]');

  function getRecaptchaToken() {
    if (!recaptchaSiteKey || typeof window.grecaptcha === 'undefined') {
      return Promise.resolve('');
    }
    return new Promise((resolve) => {
      window.grecaptcha.ready(() => {
        window.grecaptcha
          .execute(recaptchaSiteKey, { action: RECAPTCHA_ACTION })
          .then(resolve)
          .catch(() => resolve(''));
      });
    });
  }

  function showStatus(variant, message) {
    if (
      !(status instanceof HTMLElement) ||
      !(statusText instanceof HTMLElement)
    ) {
      return;
    }
    status.className = variant;
    statusText.textContent = message;
    status.hidden = false;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (
      !(form instanceof HTMLFormElement) ||
      !(status instanceof HTMLElement)
    ) {
      return;
    }

    const submitButton = form.querySelector("button[type='submit']");
    submitButton?.setAttribute('disabled', 'true');
    status.hidden = true;
    if (statusText instanceof HTMLElement) {
      statusText.textContent = '';
    }

    try {
      const token = await getRecaptchaToken();
      const formData = new FormData(form);
      formData.set('g-recaptcha-response', token);

      const response = await fetch(form.action, {
        body: formData,
        headers: { Accept: 'application/json' },
        method: form.method,
      });
      const result = await response.json();

      showStatus(response.ok ? 'success' : 'error', result.message);

      if (response.ok) {
        form.reset();
      }
    } catch {
      showStatus('error', 'Die Nachricht konnte nicht gesendet werden.');
    } finally {
      submitButton?.removeAttribute('disabled');
    }
  });
</script>
