---
import setup from '@data/setup.json';

const { host: matomoHost, siteId: matomoSiteId } = setup.matomo;
---

<script
  is:inline
  define:vars={{ matomoHost, matomoSiteId }}
>
  window._paq = window._paq || [];
  const _paq = window._paq;
  /* tracker methods like "setCustomDimension" MUST be called before "trackPageView" */
  _paq.push(['setDoNotTrack', true]);
  _paq.push(['disableCookies']);
  _paq.push(['trackPageView']);
  _paq.push(['enableLinkTracking']);
  (() => {
    const u = matomoHost;
    _paq.push(['setTrackerUrl', u + 'matomo.php']);
    _paq.push(['setSiteId', matomoSiteId]);
    const d = document;
    const g = d.createElement('script');
    const s = d.getElementsByTagName('script')[0];
    g.async = true;
    g.src = u + 'matomo.js';
    s.parentNode.insertBefore(g, s);
  })();
</script>
<noscript>
  <p>
    <img
      referrerpolicy="no-referrer-when-downgrade"
      src={`${matomoHost}matomo.php?idsite=${matomoSiteId}&rec=1`}
      class="border-0"
      alt=""
      aria-hidden="true"
      width="1"
      height="1"
      style="position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0)"
    >
  </p>
</noscript>
