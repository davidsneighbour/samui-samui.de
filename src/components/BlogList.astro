---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '@components/FormattedDate.astro';
import Pagination from '@components/ui/pagination.astro';
import { getPostUrl as getCanonicalPostUrl } from '@utils/posts';
import { humanize, slugify } from '@utils/slugify';

interface Props {
  posts: CollectionEntry<'posts'>[];
  pageNumber: number;
  totalPages: number;
  basePath?: string;
}

const normalizeBasePath = (path = '') => {
  const trimmed = path.replace(/\/+$/, '');
  if (!trimmed || trimmed === '/') return '';
  return trimmed.startsWith('/') ? trimmed : `/${trimmed}`;
};

const ensureLeadingSlash = (path: string) =>
  path.startsWith('/') ? path : `/${path}`;

const basePath = normalizeBasePath((Astro.props as Props).basePath);
const { posts, pageNumber, totalPages } = Astro.props as Props;

const pageHref = (page: number) =>
  page === 1 ? basePath || '/' : `${basePath || ''}/seite/${page}/`;

const previousPage =
  pageNumber > 1 ? ensureLeadingSlash(pageHref(pageNumber - 1)) : undefined;
const nextPage =
  pageNumber < totalPages
    ? ensureLeadingSlash(pageHref(pageNumber + 1))
    : undefined;

const getPostUrl = (post: CollectionEntry<'posts'>) =>
  ensureLeadingSlash(`${basePath}${getCanonicalPostUrl(post)}`);
---

<section
  class="mx-auto max-w-5xl rounded-(--radius) bg-card px-4 py-8 text-card-foreground sm:px-8"
>
  <ul class="flex flex-wrap gap-8">
    {posts.map((post, index) => (
        <li class:list={["group", index === 0 ? "w-full text-center" : "w-full sm:w-[calc(50%-1rem)]"]}>
          <a href={getPostUrl(post)} class="block">
            {post.data.featured_image && (
              <img
                src={post.data.featured_image}
                alt={post.data.title}
                loading="lazy"
                class:list={["mb-2 rounded-(--radius) transition-shadow group-hover:shadow-lg", index === 0 ? "w-full" : "w-full"]}
              />
            )}
            <h4
              class:list={[
                "m-0 leading-tight text-card-foreground group-hover:text-link",
                index === 0 ? "text-3xl sm:text-4xl" : "text-xl",
              ]}
            >
              {post.data.title}
            </h4>
            <p class="m-0 text-muted-foreground group-hover:text-link">
              <FormattedDate date={post.data.date} />
            </p>
          </a>
          {post.data.tags && post.data.tags.length > 0 && (
            <p class="m-0 mt-1 text-sm text-muted-foreground">
              {post.data.tags.map((tag, index) => (
                <>
                  {index > 0 && ' / '}
                  <a
                    href={`/tags/${slugify(tag)}/`}
                    class="text-link hover:underline"
                  >
                    {humanize(tag)}
                  </a>
                </>
              ))}
            </p>
          )}
        </li>
      ))}
  </ul>
  {(previousPage || nextPage) && (
      <Pagination
        previousHref={previousPage}
        nextHref={nextPage}
        pageNumber={pageNumber}
        totalPages={totalPages}
      />
    )}
</section>
