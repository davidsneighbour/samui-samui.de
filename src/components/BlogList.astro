---
import type { CollectionEntry } from 'astro:content';
import BlogPostMeta from '@components/BlogPostMeta.astro';
import BlogPostTitle from '@components/BlogPostTitle.astro';
import Giscus from '@components/Giscus.astro';
import PostCover from '@components/PostCover.astro';
import Button from '@components/ui/button.astro';
import Pagination from '@components/ui/pagination.astro';
import Separator from '@components/ui/separator.astro';
import VimeoScript from '@components/VimeoScript.astro';
import YoutubeScript from '@components/YoutubeScript.astro';
import { getPostCover } from '@utils/covers';
import { getPostPreviewHtml } from '@utils/post-preview';
import { getPostUrl as getCanonicalPostUrl } from '@utils/posts';
import { proseClasses } from '@utils/prose';

interface Props {
  posts: CollectionEntry<'posts'>[];
  pageNumber: number;
  totalPages: number;
  basePath?: string;
  featuredFirst?: boolean;
}

const normalizeBasePath = (path = '') => {
  const trimmed = path.replace(/\/+$/, '');
  if (!trimmed || trimmed === '/') return '';
  return trimmed.startsWith('/') ? trimmed : `/${trimmed}`;
};

const ensureLeadingSlash = (path: string) =>
  path.startsWith('/') ? path : `/${path}`;

const basePath = normalizeBasePath((Astro.props as Props).basePath);
const {
  featuredFirst = false,
  posts,
  pageNumber,
  totalPages,
} = Astro.props as Props;

const pageHref = (page: number) =>
  page === 1 ? basePath || '/' : `${basePath || ''}/seite/${page}/`;

const previousPage =
  pageNumber > 1 ? ensureLeadingSlash(pageHref(pageNumber - 1)) : undefined;
const nextPage =
  pageNumber < totalPages
    ? ensureLeadingSlash(pageHref(pageNumber + 1))
    : undefined;

const getPostUrl = (post: CollectionEntry<'posts'>) =>
  ensureLeadingSlash(`${basePath}${getCanonicalPostUrl(post)}`);

const getPostDiscussionTerm = (post: CollectionEntry<'posts'>) =>
  getCanonicalPostUrl(post);

const shouldFeaturePost = (index: number) =>
  featuredFirst && pageNumber === 1 && index === 0;

const listedPosts = await Promise.all(
  posts.map(async (post, index) => {
    const featured = shouldFeaturePost(index);

    return {
      cover: await getPostCover(post),
      fullPostHtml: featured
        ? (post.rendered?.html ?? getPostPreviewHtml(post, 5).join('\n'))
        : undefined,
      hasVimeo: featured && (post.body?.includes('dnb-vimeo') ?? false),
      hasYoutube: featured && (post.body?.includes('dnb-youtube') ?? false),
      post,
      summary: getPostPreviewHtml(post, 1).join('\n'),
    };
  }),
);

const coverOutlineClass =
  'outline outline-1 -outline-offset-1 outline-black/10 dark:outline-white/10';
const showPagination = totalPages > 1;
const showTopPagination = showPagination && pageNumber > 1;
---

{showTopPagination && (
    <Pagination
      basePath={basePath}
      placement="top"
      previousHref={previousPage}
      nextHref={nextPage}
      pageNumber={pageNumber}
      totalPages={totalPages}
    />
  )}
<ul class="mx-auto flex max-w-4xl flex-col gap-8 px-4">
  {listedPosts.map(({ cover, fullPostHtml, hasVimeo, hasYoutube, post, summary }, index) => (
      <li>
        {shouldFeaturePost(index) ? (
            <article class="overflow-hidden rounded-(--radius) bg-card text-card-foreground">
              {cover && (
                <PostCover
                  cover={cover}
                  eager
                  figureClass="m-0 w-full"
                  imageClass={`block h-auto w-full ${coverOutlineClass}`}
                  videoClass={`block aspect-video w-full overflow-hidden ${coverOutlineClass}`}
                  presentationWidth={896}
                />
              )}
              <div class="px-4 py-8 sm:px-8">
                <header class="mb-8 text-center">
                  <BlogPostTitle
                    title={post.data.title}
                    href={getPostUrl(post)}
                  />
                  <BlogPostMeta
                    date={post.data.date}
                    themen={post.data.themen}
                    class="mb-4 mt-3"
                  />
                  <Separator />
                </header>
                {hasVimeo && <VimeoScript />}
                {hasYoutube && <YoutubeScript />}
                <div
                  class:list={[proseClasses, 'text-pretty']}
                  set:html={fullPostHtml}
                >
                </div>
              </div>
              <div class="border-t border-card-foreground/10 px-4 py-8 sm:px-8">
                <Giscus
                  mapping="specific"
                  term={getPostDiscussionTerm(post)}
                />
              </div>
            </article>
          ) : (
            <article class="group rounded-(--radius) border border-transparent bg-card px-4 py-6 text-card-foreground transition-colors duration-200 hover:border-border/60 focus-within:border-border/60 sm:px-6">
              <div
                class:list={[
                  'flex flex-col gap-4',
                  cover && (index % 2 === 0 ? 'md:flex-row-reverse' : 'md:flex-row'),
                  !cover && 'md:block',
                ]}
              >
                {cover && (
                  <PostCover
                    cover={cover}
                    figureClass="m-0 overflow-hidden rounded-[calc(var(--radius)-4px)] md:w-1/3 md:shrink-0"
                    imageClass={`block aspect-[4/3] h-auto w-full rounded-[calc(var(--radius)-4px)] object-cover transition-transform duration-300 ease-out group-hover:scale-105 group-focus-within:scale-105 ${coverOutlineClass}`}
                    videoClass={`block aspect-video w-full overflow-hidden rounded-[calc(var(--radius)-4px)] ${coverOutlineClass}`}
                    captionClass="sr-only"
                    sizes="(min-width: 768px) 288px, 100vw"
                  />
                )}
                <div class="min-w-0 flex-1">
                  <header class="mb-3">
                    <BlogPostTitle
                      title={post.data.title}
                      href={getPostUrl(post)}
                      size="compact"
                    />
                    <BlogPostMeta
                      date={post.data.date}
                      themen={post.data.themen}
                      class="mt-2"
                    />
                  </header>
                  <div
                    class:list={[proseClasses, 'text-pretty']}
                    set:html={summary}
                  >
                  </div>
                  <p class="m-0 flex justify-end">
                    <Button
                      href={getPostUrl(post)}
                      size="sm"
                      variant="default"
                    >
                      Weiterlesen
                    </Button>
                  </p>
                </div>
              </div>
            </article>
          )}
      </li>
    ))}
</ul>
{showPagination && (
    <Pagination
      basePath={basePath}
      placement="bottom"
      previousHref={previousPage}
      nextHref={nextPage}
      pageNumber={pageNumber}
      totalPages={totalPages}
    />
  )}
