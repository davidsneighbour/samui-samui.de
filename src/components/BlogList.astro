---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '@components/FormattedDate.astro';
import PostCover from '@components/PostCover.astro';
import Button from '@components/ui/button.astro';
import Pagination from '@components/ui/pagination.astro';
import Separator from '@components/ui/separator.astro';
import { getPostCover } from '@utils/covers';
import { getPostUrl as getCanonicalPostUrl } from '@utils/posts';
import { humanize, slugify } from '@utils/slugify';

interface Props {
  posts: CollectionEntry<'posts'>[];
  pageNumber: number;
  totalPages: number;
  basePath?: string;
  featuredFirst?: boolean;
}

const normalizeBasePath = (path = '') => {
  const trimmed = path.replace(/\/+$/, '');
  if (!trimmed || trimmed === '/') return '';
  return trimmed.startsWith('/') ? trimmed : `/${trimmed}`;
};

const ensureLeadingSlash = (path: string) =>
  path.startsWith('/') ? path : `/${path}`;

const basePath = normalizeBasePath((Astro.props as Props).basePath);
const {
  featuredFirst = false,
  posts,
  pageNumber,
  totalPages,
} = Astro.props as Props;

const pageHref = (page: number) =>
  page === 1 ? basePath || '/' : `${basePath || ''}/seite/${page}/`;

const previousPage =
  pageNumber > 1 ? ensureLeadingSlash(pageHref(pageNumber - 1)) : undefined;
const nextPage =
  pageNumber < totalPages
    ? ensureLeadingSlash(pageHref(pageNumber + 1))
    : undefined;

const getPostUrl = (post: CollectionEntry<'posts'>) =>
  ensureLeadingSlash(`${basePath}${getCanonicalPostUrl(post)}`);

const stripMarkdownPreview = (value: string) =>
  value
    .replaceAll(/!\[[^\]]*\]\([^)]+\)/g, '')
    .replaceAll(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replaceAll(/`([^`]+)`/g, '$1')
    .replaceAll(/\*\*([^*]+)\*\*/g, '$1')
    .replaceAll(/\*([^*]+)\*/g, '$1')
    .replaceAll(/_{1,2}([^_]+)_{1,2}/g, '$1')
    .replaceAll(/^#{1,6}\s+/gm, '')
    .replaceAll(/^>\s?/gm, '')
    .replaceAll(/\s+/g, ' ')
    .trim();

const getBodyPreview = (
  post: CollectionEntry<'posts'>,
  paragraphCount: number,
) =>
  (post.body ?? '')
    .split(/\n{2,}/)
    .map(stripMarkdownPreview)
    .filter(Boolean)
    .slice(0, paragraphCount);

const getFrontmatterPreview = (post: CollectionEntry<'posts'>) => {
  const frontmatterSummary = post.data.summary?.trim();
  if (frontmatterSummary) return [frontmatterSummary];

  const description = post.data.description?.trim();
  if (description) return [description];

  return [];
};

const listedPosts = posts.map((post) => {
  const bodyPreview = getBodyPreview(post, 3);
  const frontmatterPreview = getFrontmatterPreview(post);

  return {
    cover: getPostCover(post),
    featuredPreview: bodyPreview.length > 0 ? bodyPreview : frontmatterPreview,
    post,
    summary:
      frontmatterPreview.length > 0
        ? frontmatterPreview
        : bodyPreview.slice(0, 1),
  };
});

const shouldFeaturePost = (index: number) =>
  featuredFirst && pageNumber === 1 && index === 0;
---

<ul class="mx-auto flex max-w-4xl flex-col gap-8 px-4">
  {listedPosts.map(({ cover, featuredPreview, post, summary }, index) => (
      <li>
        {index > 0 && <Separator class="mb-8" />}
        {shouldFeaturePost(index) ? (
            <article class="rounded-(--radius) bg-card px-4 py-8 text-card-foreground sm:px-8">
              <header class="mb-4">
                <h2
                  class="m-0 text-balance text-3xl font-[600] leading-tight uppercase sm:text-4xl"
                >
                  <a
                    href={getPostUrl(post)}
                    class="text-link hover:underline"
                  >
                    {post.data.title}
                  </a>
                </h2>
                <p class="m-0 mt-1 text-sm text-muted-foreground">
                  <FormattedDate date={post.data.date} />
                  {post.data.tags && post.data.tags.length > 0 && (
                    <>
                      {' — '}
                      {post.data.tags.map((tag, tagIndex) => (
                        <>
                          {tagIndex > 0 && ' / '}
                          <a
                            href={`/tags/${slugify(tag)}/`}
                            class="text-link hover:underline"
                          >
                            {humanize(tag)}
                          </a>
                        </>
                      ))}
                    </>
                  )}
                </p>
              </header>
              {cover && (
                <PostCover
                  cover={cover}
                  eager
                  figureClass="mb-6"
                  imageClass="block h-auto w-full rounded-[calc(var(--radius)-4px)] outline outline-1 -outline-offset-1 outline-black/10"
                />
              )}
              <div class="space-y-4">
                {featuredPreview.map((paragraph) => (
                  <p
                    class="m-0 max-w-none text-pretty text-base leading-7 text-card-foreground"
                    set:html={paragraph}
                  />
                ))}
              </div>
              <p class="m-0 mt-6 flex justify-end">
                <Button
                  href={getPostUrl(post)}
                  variant="default"
                >
                  Weiterlesen
                </Button>
              </p>
            </article>
          ) : (
            <article class="rounded-(--radius) bg-card px-4 py-6 text-card-foreground sm:px-6">
              <div class:list={['flex flex-col gap-4 md:flex-row', !cover && 'md:block']}>
                {cover && (
                  <PostCover
                    cover={cover}
                    figureClass="m-0 md:w-1/3 md:shrink-0"
                    imageClass="block aspect-[4/3] h-auto w-full rounded-[calc(var(--radius)-4px)] object-cover outline outline-1 -outline-offset-1 outline-black/10"
                    captionClass="sr-only"
                    sizes="(min-width: 768px) 288px, 100vw"
                  />
                )}
                <div class="min-w-0 flex-1">
                  <header class="mb-3">
                    <h2
                      class="m-0 text-balance text-2xl font-[600] leading-tight uppercase"
                    >
                      <a
                        href={getPostUrl(post)}
                        class="text-link hover:underline"
                      >
                        {post.data.title}
                      </a>
                    </h2>
                    <p class="m-0 mt-1 text-sm text-muted-foreground">
                      <FormattedDate date={post.data.date} />
                      {post.data.tags && post.data.tags.length > 0 && (
                        <>
                          {' — '}
                          {post.data.tags.map((tag, tagIndex) => (
                            <>
                              {tagIndex > 0 && ' / '}
                              <a
                                href={`/tags/${slugify(tag)}/`}
                                class="text-link hover:underline"
                              >
                                {humanize(tag)}
                              </a>
                            </>
                          ))}
                        </>
                      )}
                    </p>
                  </header>
                  {summary.map((paragraph) => (
                    <p
                      class="m-0 mb-4 text-pretty text-base leading-7 text-card-foreground"
                      set:html={paragraph}
                    />
                  ))}
                  <p class="m-0 flex justify-end">
                    <Button
                      href={getPostUrl(post)}
                      size="sm"
                      variant="default"
                    >
                      Weiterlesen
                    </Button>
                  </p>
                </div>
              </div>
            </article>
          )}
      </li>
    ))}
</ul>
{totalPages > 1 && (
    <Pagination
      basePath={basePath}
      previousHref={previousPage}
      nextHref={nextPage}
      pageNumber={pageNumber}
      totalPages={totalPages}
    />
  )}
