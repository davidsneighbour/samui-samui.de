---
import { MAP_CONFIG, type MapDialogPayload } from '@config/maps';
import { X } from '@lucide/astro';
import { getMapLocationValidationError } from '@utils/map-validation';

export interface Props {
  buttonLabel?: string;
  dialogTitle: string;
  latitude: number;
  longitude: number;
  zoom?: number;
  markerTitle: string;
  markerDescription?: string;
}

const {
  buttonLabel = 'Show map',
  dialogTitle,
  latitude,
  longitude,
  zoom = MAP_CONFIG.defaultZoom,
  markerTitle,
  markerDescription,
} = Astro.props as Props;

const instanceId = `map-dialog-${crypto.randomUUID()}`;
const titleId = `${instanceId}-title`;
const mapLabelId = `${instanceId}-map-label`;
const errorId = `${instanceId}-error`;
const fallbackId = `${instanceId}-fallback`;

const validationError = getMapLocationValidationError({
  latitude,
  longitude,
  zoom,
});

const payload: MapDialogPayload = {
  dialogTitle,
  latitude,
  longitude,
  markerTitle,
  zoom,
  ...(markerDescription ? { markerDescription } : {}),
};

function formatCoordinate(value: number): string {
  return Number.isFinite(value) ? value.toFixed(6) : 'invalid';
}
---

<div
  class="map-dialog"
  data-map-dialog
  data-map-payload={JSON.stringify(payload)}
  data-map-validation-error={validationError}
>
  <button
    type="button"
    class="map-dialog__trigger"
    aria-describedby={fallbackId}
    disabled={Boolean(validationError)}
    data-map-dialog-trigger
  >
    {buttonLabel}
  </button>
  <p
    id={fallbackId}
    class="map-dialog__fallback"
  >
    {markerTitle}: {formatCoordinate(latitude)}, {formatCoordinate(longitude)}
  </p>
  {validationError && (
      <p class="map-dialog__invalid">
        This map is unavailable because its configured coordinates are invalid.
      </p>
    )}
  <dialog
    class="map-dialog__modal"
    aria-labelledby={titleId}
    aria-describedby={errorId}
    data-map-dialog-modal
  >
    <div class="map-dialog__panel">
      <header class="map-dialog__header">
        <h2
          id={titleId}
          class="map-dialog__title"
        >
          {dialogTitle}
        </h2>
        <button
          type="button"
          class="map-dialog__close"
          aria-label="Karte schließen"
          data-map-dialog-close
        >
          <X
            aria-hidden="true"
            class="map-dialog__close-icon"
          />
        </button>
      </header>
      <p
        id={errorId}
        class="map-dialog__error"
        hidden
        data-map-dialog-error
      >
        Die Karte konnte nicht geladen werden. Bitte schließen und erneut
        versuchen.
      </p>
      <div
        id={mapLabelId}
        class="map-dialog__map-label"
      >
        Interaktive Karte für {markerTitle}
      </div>
      <div
        class="map-dialog__map"
        role="region"
        aria-labelledby={mapLabelId}
        data-map-dialog-container
      ></div>
    </div>
  </dialog>
</div>

<script>
  import { MAP_CONFIG, type MapDialogPayload } from '@config/maps';
  import { getMapLocationValidationError } from '@utils/map-validation';
  import type { Map as MapLibreMapInstance, Marker, Popup } from 'maplibre-gl';

  type MapLibreModule = typeof import('maplibre-gl');

  type MapDialogElements = {
    root: HTMLElement;
    trigger: HTMLButtonElement;
    modal: HTMLDialogElement;
    closeButton: HTMLButtonElement;
    mapContainer: HTMLElement;
    errorMessage: HTMLElement;
    payload: MapDialogPayload;
  };

  let maplibrePromise: Promise<MapLibreModule> | undefined;

  function loadMapLibre(): Promise<MapLibreModule> {
    maplibrePromise ??= import('maplibre-gl');
    return maplibrePromise;
  }

  function getErrorMessage(error: unknown): string {
    return error instanceof Error ? error.message : String(error);
  }

  function throwIfAborted(signal: AbortSignal): void {
    if (signal.aborted) {
      throw new Error('Map dialog initialization was aborted.');
    }
  }

  function parsePayload(root: HTMLElement): MapDialogPayload | undefined {
    const rawPayload = root.dataset.mapPayload;
    if (!rawPayload) return undefined;

    try {
      return JSON.parse(rawPayload) as MapDialogPayload;
    } catch (error: unknown) {
      console.error(
        'Map dialog payload could not be parsed.',
        getErrorMessage(error),
      );
      return undefined;
    }
  }

  function getElements(root: HTMLElement): MapDialogElements | undefined {
    const trigger = root.querySelector<HTMLButtonElement>(
      '[data-map-dialog-trigger]',
    );
    const modal = root.querySelector<HTMLDialogElement>(
      '[data-map-dialog-modal]',
    );
    const closeButton = root.querySelector<HTMLButtonElement>(
      '[data-map-dialog-close]',
    );
    const mapContainer = root.querySelector<HTMLElement>(
      '[data-map-dialog-container]',
    );
    const errorMessage = root.querySelector<HTMLElement>(
      '[data-map-dialog-error]',
    );
    const payload = parsePayload(root);

    if (
      !trigger ||
      !modal ||
      !closeButton ||
      !mapContainer ||
      !errorMessage ||
      !payload
    ) {
      console.error('Map dialog markup is incomplete.');
      return undefined;
    }

    return {
      closeButton,
      errorMessage,
      mapContainer,
      modal,
      payload,
      root,
      trigger,
    };
  }

  function nextAnimationFrame(): Promise<void> {
    return new Promise((resolve) => {
      requestAnimationFrame(() => resolve());
    });
  }

  function showError(errorMessage: HTMLElement, message?: string): void {
    errorMessage.hidden = false;
    errorMessage.textContent =
      message ??
      'Die Karte konnte nicht geladen werden. Bitte schließen und erneut versuchen.';
  }

  function hideError(errorMessage: HTMLElement): void {
    errorMessage.hidden = true;
  }

  function setScrollProtection(enabled: boolean): void {
    document.documentElement.classList.toggle('map-dialog-open', enabled);
  }

  function createPopupContent(payload: MapDialogPayload): HTMLElement {
    const content = document.createElement('div');
    content.className = 'map-dialog-popup';

    const title = document.createElement('strong');
    title.className = 'map-dialog-popup__title';
    title.textContent = payload.markerTitle;
    content.append(title);

    if (payload.markerDescription) {
      const description = document.createElement('p');
      description.className = 'map-dialog-popup__description';
      description.textContent = payload.markerDescription;
      content.append(description);
    }

    return content;
  }

  function createMarkerElement(payload: MapDialogPayload): HTMLElement {
    const markerElement = document.createElement('button');
    markerElement.type = 'button';
    markerElement.className = 'map-dialog__marker';
    markerElement.setAttribute('aria-label', payload.markerTitle);

    const markerDot = document.createElement('span');
    markerDot.className = 'map-dialog__marker-dot';
    markerDot.setAttribute('aria-hidden', 'true');
    markerElement.append(markerDot);

    return markerElement;
  }

  async function createMap(
    elements: MapDialogElements,
    signal: AbortSignal,
  ): Promise<{ map: MapLibreMapInstance; marker: Marker; popup: Popup }> {
    const maplibregl = await loadMapLibre();
    throwIfAborted(signal);

    const {
      Map: MapLibreMap,
      Marker: MapLibreMarker,
      NavigationControl,
      Popup: MapLibrePopup,
    } = maplibregl;
    const { mapContainer, payload } = elements;
    const coordinates: [number, number] = [payload.longitude, payload.latitude];
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    const map = new MapLibreMap({
      center: coordinates,
      container: mapContainer,
      maxZoom: MAP_CONFIG.maxZoom,
      style: MAP_CONFIG.styleUrl,
      zoom: payload.zoom,
    });

    map.addControl(new NavigationControl({ showCompass: true }), 'top-right');

    const popup = new MapLibrePopup({
      closeButton: true,
      closeOnClick: false,
      focusAfterOpen: false,
      offset: 28,
    }).setDOMContent(createPopupContent(payload));

    const markerElement = createMarkerElement(payload);
    const marker = new MapLibreMarker({
      anchor: 'bottom',
      element: markerElement,
    })
      .setLngLat(coordinates)
      .setPopup(popup)
      .addTo(map);

    const openPopup = () => {
      popup.setDOMContent(createPopupContent(payload));
      popup.setLngLat(coordinates).addTo(map);
    };

    markerElement.addEventListener(
      'click',
      () => {
        openPopup();
      },
      { signal },
    );
    markerElement.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        openPopup();
      },
      { signal },
    );

    map.once('load', () => {
      if (prefersReducedMotion) {
        map.jumpTo({ center: coordinates, zoom: payload.zoom });
      }
      openPopup();
    });

    return { map, marker, popup };
  }

  function setupMapDialog(root: HTMLElement): void {
    if (root.dataset.mapDialogReady === 'true') return;
    root.dataset.mapDialogReady = 'true';

    const elements = getElements(root);
    if (!elements) return;

    const validationError =
      root.dataset.mapValidationError ||
      getMapLocationValidationError({
        latitude: elements.payload.latitude,
        longitude: elements.payload.longitude,
        zoom: elements.payload.zoom,
      });

    if (validationError) {
      elements.trigger.disabled = true;
      return;
    }

    let map: MapLibreMapInstance | undefined;
    let marker: Marker | undefined;
    let popup: Popup | undefined;
    let mapAbortController: AbortController | undefined;

    const destroyMap = () => {
      mapAbortController?.abort();
      mapAbortController = undefined;
      popup?.remove();
      marker?.remove();
      map?.remove();
      popup = undefined;
      marker = undefined;
      map = undefined;
      elements.mapContainer.replaceChildren();
    };

    const openDialog = async () => {
      hideError(elements.errorMessage);
      if (!elements.modal.open) {
        elements.modal.showModal();
      }
      setScrollProtection(true);
      await nextAnimationFrame();
      destroyMap();
      const controller = new AbortController();
      mapAbortController = controller;

      try {
        const mapParts = await createMap(elements, controller.signal);
        if (controller.signal.aborted) {
          mapParts.popup.remove();
          mapParts.marker.remove();
          mapParts.map.remove();
          return;
        }
        map = mapParts.map;
        marker = mapParts.marker;
        popup = mapParts.popup;
        map.resize();
      } catch (error: unknown) {
        if (controller.signal.aborted) return;
        destroyMap();
        console.error(
          'Map dialog failed to initialize.',
          getErrorMessage(error),
        );
        showError(elements.errorMessage);
      }
    };

    elements.trigger.addEventListener('click', () => {
      void openDialog();
    });

    elements.closeButton.addEventListener('click', () => {
      elements.modal.close();
    });

    elements.modal.addEventListener('close', () => {
      destroyMap();
      setScrollProtection(false);
      elements.trigger.focus();
    });

    window.addEventListener('pagehide', destroyMap, { once: true });
  }

  document
    .querySelectorAll<HTMLElement>('[data-map-dialog]')
    .forEach(setupMapDialog);
</script>

<style>
  :global(html.map-dialog-open) {
    overflow: hidden;
  }

  .map-dialog {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .map-dialog__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-secondary);
    color: var(--color-secondary-foreground);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      color 150ms ease,
      border-color 150ms ease;
  }

  .map-dialog__trigger:hover {
    background: color-mix(
      in srgb,
      var(--color-secondary) 88%,
      var(--color-primary)
    );
  }

  .map-dialog__trigger:focus-visible,
  .map-dialog__close:focus-visible,
  :global(.map-dialog__marker:focus-visible) {
    outline: 2px solid var(--color-ring);
    outline-offset: 3px;
  }

  .map-dialog__trigger:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .map-dialog__fallback,
  .map-dialog__invalid {
    margin: 0;
    color: var(--color-muted-foreground);
    font-size: 0.875rem;
  }

  .map-dialog__modal {
    width: min(64rem, calc(100vw - 2rem));
    max-width: none;
    height: min(42rem, calc(100vh - 2rem));
    max-height: none;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-card);
    color: var(--color-card-foreground);
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 0.35);
  }

  .map-dialog__modal::backdrop {
    background: rgb(0 0 0 / 0.66);
  }

  .map-dialog__panel {
    display: grid;
    grid-template-rows: auto auto auto minmax(18rem, 1fr);
    height: 100%;
    min-height: 0;
  }

  .map-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .map-dialog__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .map-dialog__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) - 4px);
    background: transparent;
    color: currentColor;
    cursor: pointer;
  }

  .map-dialog__close:hover {
    background: var(--color-accent);
    color: var(--color-accent-foreground);
  }

  .map-dialog__close-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .map-dialog__error {
    margin: 0;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-primary);
    color: var(--color-primary-foreground);
    font-weight: 600;
  }

  .map-dialog__map-label {
    padding: 0.75rem 1rem;
    color: var(--color-muted-foreground);
    font-size: 0.875rem;
  }

  .map-dialog__map {
    min-height: 18rem;
    background: var(--color-muted);
  }

  :global(.map-dialog__marker) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 2px solid var(--color-card);
    border-radius: 9999px;
    background: var(--color-primary);
    box-shadow: 0 0.25rem 0.75rem rgb(0 0 0 / 0.45);
    cursor: pointer;
  }

  :global(.map-dialog__marker-dot) {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: inherit;
    background: var(--color-primary-foreground);
  }

  :global(.maplibregl-popup-content) {
    max-width: 18rem;
    padding: 0.75rem 1rem;
    border-radius: calc(var(--radius) - 4px);
    background: var(--color-card);
    color: var(--color-card-foreground);
    font-family: var(--font-sans);
    box-shadow: 0 0.75rem 1.5rem rgb(0 0 0 / 0.25);
  }

  :global(.maplibregl-popup-tip) {
    border-top-color: var(--color-card);
  }

  :global(.map-dialog-popup) {
    display: grid;
    gap: 0.35rem;
  }

  :global(.map-dialog-popup__title) {
    font-size: 0.95rem;
    line-height: 1.25;
  }

  :global(.map-dialog-popup__description) {
    margin: 0;
    color: var(--color-muted-foreground);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .map-dialog__modal {
      width: calc(100vw - 1rem);
      height: calc(100vh - 1rem);
    }

    .map-dialog__panel {
      grid-template-rows: auto auto auto minmax(20rem, 1fr);
    }
  }
</style>
