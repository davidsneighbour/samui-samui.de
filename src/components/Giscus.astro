---
// Lazy-loaded giscus comments widget, adapted from
// davidsneighbour/kollitsch.dev's src/components/features/comments/Giscus.astro
// reference. Loads the giscus client only once the widget scrolls into view.
//
// Requires the giscus GitHub App installed on this repo before comments will
// actually render. The repo-root giscus.json is intentional: giscus reads it
// from the public GitHub repository configured below, not from the live site.
const repo = 'davidsneighbour/samui-samui.de';
const repoId = 'MDEwOlJlcG9zaXRvcnkxNjI5NzM3MTA=';
const category = 'Kommentare';
const categoryId = 'DIC_kwDOCbbIDs4DBbj1';
const themeLight = '/assets/styles/giscus-samui-light.css';
const themeDark = '/assets/styles/giscus-samui-dark.css';
---

<dnb-giscus
  data-repo={repo}
  data-repo-id={repoId}
  data-category={category}
  data-category-id={categoryId}
  data-mapping="pathname"
  data-strict="0"
  data-lang="en"
  data-reactions-enabled="1"
  data-emit-metadata="1"
  data-input-position="bottom"
  data-theme-light={themeLight}
  data-theme-dark={themeDark}
  data-loading="lazy"
></dnb-giscus>

<script>
  if (!customElements.get('dnb-giscus')) {
    type SamuiThemeName = 'light' | 'dark';

    const giscusOrigin = 'https://giscus.app';

    class DnbGiscus extends HTMLElement {
      #initialised = false;

      #handleThemeChange = (event: Event): void => {
        const theme =
          event instanceof CustomEvent && event.detail?.theme === 'light'
            ? 'light'
            : 'dark';
        this.syncTheme(theme);
      };

      static #observer: IntersectionObserver | undefined;

      static get observer(): IntersectionObserver {
        if (!DnbGiscus.#observer) {
          DnbGiscus.#observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  const el = entry.target as DnbGiscus;
                  el.loadGiscus();
                  DnbGiscus.#observer?.unobserve(el);
                }
              }
            },
            { rootMargin: '0px 0px 200px 0px', threshold: 0.01 },
          );
        }
        return DnbGiscus.#observer;
      }

      get currentTheme(): SamuiThemeName {
        const samuiTheme = (
          window as Window & { SamuiTheme?: { getTheme: () => string } }
        ).SamuiTheme;
        return samuiTheme?.getTheme() === 'light' ? 'light' : 'dark';
      }

      themeUrl(theme: SamuiThemeName = this.currentTheme): string {
        const themePath =
          theme === 'light' ? this.dataset.themeLight : this.dataset.themeDark;

        if (!themePath) return theme;

        return new URL(themePath, window.location.origin).href;
      }

      syncTheme(theme: SamuiThemeName = this.currentTheme): void {
        const themeUrl = this.themeUrl(theme);
        const script = this.querySelector<HTMLScriptElement>(
          'script[src="https://giscus.app/client.js"]',
        );
        script?.setAttribute('data-theme', themeUrl);

        const iframe = this.querySelector<HTMLIFrameElement>(
          'iframe.giscus-frame',
        );
        iframe?.contentWindow?.postMessage(
          { giscus: { setConfig: { theme: themeUrl } } },
          giscusOrigin,
        );
      }

      loadGiscus(): void {
        if (this.#initialised || this.hasAttribute('data-initialised')) return;

        const ds = this.dataset;
        const themeUrl = this.themeUrl();
        const attrs: Record<string, string> = {
          async: '',
          crossorigin: 'anonymous',
          'data-category': ds.category ?? '',
          'data-category-id': ds.categoryId ?? '',
          'data-emit-metadata': ds.emitMetadata ?? '0',
          'data-input-position': ds.inputPosition ?? 'bottom',
          'data-lang': ds.lang ?? 'de',
          'data-loading': ds.loading ?? 'lazy',
          'data-mapping': ds.mapping ?? 'pathname',
          'data-reactions-enabled': ds.reactionsEnabled ?? '1',
          'data-repo': ds.repo ?? '',
          'data-repo-id': ds.repoId ?? '',
          'data-strict': ds.strict ?? '0',
          'data-theme': themeUrl,
          src: 'https://giscus.app/client.js',
        };

        const requiredKeys = [
          'data-repo',
          'data-repo-id',
          'data-category',
          'data-category-id',
        ];
        const missing = requiredKeys.filter((key) => !attrs[key]);
        if (missing.length > 0) {
          console.error('[Giscus] Missing required attributes:', missing);
          return;
        }

        const script = document.createElement('script');
        for (const [key, value] of Object.entries(attrs)) {
          script.setAttribute(key, value);
        }

        this.appendChild(script);
        this.#initialised = true;
        this.setAttribute('data-initialised', 'true');
        this.syncTheme();
      }

      connectedCallback(): void {
        document.addEventListener(
          'samui-theme-change',
          this.#handleThemeChange,
        );
        if (this.#initialised || this.hasAttribute('data-initialised')) return;
        DnbGiscus.observer.observe(this);
      }

      disconnectedCallback(): void {
        document.removeEventListener(
          'samui-theme-change',
          this.#handleThemeChange,
        );
        DnbGiscus.observer.unobserve(this);
      }
    }

    customElements.define('dnb-giscus', DnbGiscus);
  }
</script>
