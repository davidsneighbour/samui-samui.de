---
// A small, understated "Lebenszeit, pedantisch aufgeteilt" timeline bar for
// the author footer -- not a chart, just proportional segments. See
// src/content/sitewide/authorfooter/index.mdx for where this is used and
// src/utils/life-stats.ts for how the numbers are computed.
import { formatNumberDE, formatPercentDE } from '@utils/life-stats';

interface Props {
  preSamuiDays: number;
  samuiDays: number;
  totalDays: number;
  samuiSharePercent: number;
  hasSamuiMajority: boolean;
  daysUntilOrSinceSamuiMajority: number;
}

const {
  preSamuiDays,
  samuiDays,
  totalDays,
  samuiSharePercent,
  hasSamuiMajority,
  daysUntilOrSinceSamuiMajority,
} = Astro.props;

const preSamuiPercent = (preSamuiDays / totalDays) * 100;
const samuiPercent = 100 - preSamuiPercent;
// The days still needed for samuiDays to overtake preSamuiDays, expressed as
// a slice of the still-unmatched pre-Samui portion of the bar -- highlighted
// separately so it reads as "this much more" rather than blending into the
// plain pre-Samui segment.
const remainingToMajorityPercent = hasSamuiMajority
  ? 0
  : Math.min(
      preSamuiPercent,
      (daysUntilOrSinceSamuiMajority / totalDays) * 100,
    );
const beforeSamuiPercent = preSamuiPercent - remainingToMajorityPercent;

const majorityText = hasSamuiMajority
  ? `Samui-Mehrheit seit ${formatNumberDE(daysUntilOrSinceSamuiMajority)} Tagen erreicht.`
  : `Noch ${formatNumberDE(daysUntilOrSinceSamuiMajority)} Tage bis zur Samui-Mehrheit.`;
---

<div class="not-prose my-6">
  <div
    class="relative"
    aria-hidden="true"
  >
    <div class="flex h-2.5 w-full overflow-hidden rounded-full bg-muted">
      <span
        class="block h-full bg-muted-foreground/40"
        style={`width: ${beforeSamuiPercent.toFixed(4)}%`}
      ></span>
      {remainingToMajorityPercent > 0 && (
        <span
          class="block h-full bg-primary/40"
          style={`width: ${remainingToMajorityPercent.toFixed(4)}%`}
        ></span>
      )}
      <span
        class="block h-full bg-primary"
        style={`width: ${samuiPercent.toFixed(4)}%`}
      ></span>
    </div>
    <span
      class="pointer-events-none absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-card-foreground/50"
      title="50 %"
    ></span>
  </div>
  <dl class="mt-2 flex flex-wrap justify-between gap-x-4 gap-y-0.5 text-xs">
    <div>
      <dt class="inline text-muted-foreground">Vor Samui:</dt>
      {' '}
      <dd class="inline text-muted-foreground">
        {formatNumberDE(preSamuiDays)}
        Tage
      </dd>
    </div>
    <div>
      <dt class="inline font-medium text-card-foreground">Auf Samui:</dt>
      {' '}
      <dd class="inline font-medium text-card-foreground">
        {formatNumberDE(samuiDays)}
        Tage
      </dd>
    </div>
  </dl>
  <div
    class="mt-1 flex flex-col gap-0.5 text-xs text-muted-foreground sm:flex-row sm:justify-between sm:gap-4"
  >
    <p>
      Samui-Anteil am bisherigen Gesamtwerk:{' '}
      {formatPercentDE(samuiSharePercent)}&nbsp;%
    </p>
    <p>{majorityText}</p>
  </div>
</div>
