---
import FormattedDate from '@components/content/date/FormattedDate.astro';
import ThemaBadges from '@components/content/taxonomy/ThemaBadges.astro';
import Tooltip from '@components/ui/tooltip.astro';
import { CalendarCheck, CalendarDays, Clock } from '@lucide/astro';
import { cn } from '@utils/cn';
import { formatDate } from '@utils/dates';
import type { PostReadingTime } from '@utils/reading-time';

interface Props {
  readingTime?: PostReadingTime | undefined;
  date?: Date | undefined;
  updatedDate?: Date | undefined;
  themen?: string[] | undefined;
  extended?: boolean | undefined;
  class?: string | undefined;
}

const {
  readingTime,
  date,
  updatedDate,
  themen,
  extended = false,
  class: className,
} = Astro.props as Props;
const hasThemen = themen && themen.length > 0;
const hasDates = date || updatedDate || readingTime;
const hasMeta = hasDates || hasThemen;
const updatedDateLabel = updatedDate
  ? `Aktualisiert am ${formatDate(updatedDate, { extended })}`
  : undefined;
---

{hasMeta && (
  <div
    class={cn(
      'flex flex-col items-start gap-2 text-left text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:gap-4',
      className,
    )}
  >
    {hasDates && (
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 leading-none min-w-0">
        {date && (
          <span class="inline-flex items-center gap-2 whitespace-nowrap leading-none [&_svg]:block [&_time]:leading-none">
            <CalendarDays class="size-4 shrink-0" aria-hidden="true" />
            <FormattedDate
              date={date}
              extended={extended}
              class="text-box-balanced"
            />
          </span>
        )}
        {readingTime && (
          <span class="inline-flex items-center gap-2 whitespace-nowrap leading-none">
            <Clock class="size-4 shrink-0" aria-hidden="true" />
            {readingTime.minutes > 0
              ? `ca. ${readingTime.minutes} Min. Lesezeit`
              : 'Keine Lesezeit'}
            {readingTime.hasVideo && ' + Video'}
          </span>
        )}
        {updatedDateLabel && (
          <Tooltip content={updatedDateLabel} triggerClass="size-6">
            <CalendarCheck slot="trigger" class="size-4" aria-hidden="true" />
          </Tooltip>
        )}
      </div>
    )}
    {hasThemen && <ThemaBadges themen={themen} class="sm:justify-end" />}
  </div>
)}
