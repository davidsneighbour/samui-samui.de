---
import { formatDate, formatPostTimestamp } from '@utils/dates';

interface Props {
  date: Date;
  extended?: boolean;
  class?: string;
}

const { date, extended = false, class: className } = Astro.props as Props;
---

<time
  class={className}
  datetime={formatPostTimestamp(date)}
>
  {formatDate(date, { extended })}
</time>
