---
import {
  type Currency,
  formatCurrency,
  validateAmount,
} from '@utils/currency/conversion';

interface Props {
  amount: number;
  currency: Currency;
}
const { amount, currency } = Astro.props;
validateAmount(amount, currency);
---

<dnb-currency
  amount={amount}
  currency={currency}
  ><slot>{formatCurrency(amount, currency)}</slot></dnb-currency
>
