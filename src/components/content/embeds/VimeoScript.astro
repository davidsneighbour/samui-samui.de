---
// Defines the `dnb-vimeo` custom element (a TypeScript port of
// https://github.com/slightlyoff/lite-vimeo/blob/master/lite-vimeo.ts) so raw
// `<dnb-vimeo videoid="…">` markup works both from the `Vimeo.astro` wrapper
// and from `<dnb-vimeo>` tags dropped directly into blog post markdown
// (blog posts are plain .md, not .mdx, so they cannot import Vimeo.astro).
//
// Privacy contract: nothing here may contact Vimeo before the visitor clicks.
// The poster is a local file (slot="poster", see
// documentation/content/video-thumbnail-cache.md); without one, the element
// shows a neutral black placeholder. No preconnect, no oEmbed lookup, no
// remote thumbnail, no load on scroll. See AGENTS.md and the privacy policy.
---

<script>
  if (!customElements.get('dnb-vimeo')) {
    class DnbVimeo extends HTMLElement {
      #iframeLoaded = false;
      #frame!: HTMLDivElement;
      #playButton!: HTMLButtonElement;
      #img!: HTMLImageElement;

      static get observedAttributes(): string[] {
        return ['videoid'];
      }

      constructor() {
        super();
        this.#setupDom();
      }

      get videoId(): string {
        return encodeURIComponent(this.getAttribute('videoid') ?? '');
      }

      get videoTitle(): string {
        return this.getAttribute('videotitle') ?? 'Video';
      }

      get videoPlay(): string {
        return this.getAttribute('videoplay') ?? 'Play';
      }

      get videoStartAt(): string {
        return this.getAttribute('start') ?? '0s';
      }

      get videoHash(): string {
        return encodeURIComponent(this.getAttribute('videohash') ?? '');
      }

      #setupDom(): void {
        const shadow = this.attachShadow({ mode: 'open' });
        shadow.innerHTML = `
                    <style>
                      :host {
                        contain: content;
                        display: block;
                        position: relative;
                        width: 100%;
                        aspect-ratio: 16 / 9;
                        background-color: #000;
                      }
                      #frame, iframe {
                        position: absolute;
                        inset: 0;
                        width: 100%;
                        height: 100%;
                        border: 0;
                      }
                      #frame {
                        cursor: pointer;
                      }
                      picture, img, ::slotted(picture), ::slotted(img) {
                        display: block;
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                      }
                      .dnb-vimeo-playbtn {
                        width: 70px;
                        height: 46px;
                        background-color: #212121;
                        z-index: 1;
                        opacity: 0.8;
                        border-radius: 10%;
                        transition:
                          background-color 0.2s cubic-bezier(0, 0, 0.2, 1),
                          opacity 0.2s cubic-bezier(0, 0, 0.2, 1);
                        border: 0;
                        cursor: pointer;
                        position: absolute;
                        top: 50%;
                        left: 50%;
                        transform: translate3d(-50%, -50%, 0);
                      }
                      @media (hover: hover) and (pointer: fine) {
                        #frame:hover .dnb-vimeo-playbtn {
                          background-color: rgb(98, 175, 237);
                          opacity: 1;
                        }
                      }
                      @media (prefers-reduced-motion: reduce) {
                        .dnb-vimeo-playbtn {
                          transition: none;
                        }
                      }
                      .dnb-vimeo-playbtn::before {
                        content: '';
                        border-style: solid;
                        border-width: 11px 0 11px 19px;
                        border-color: transparent transparent transparent #fff;
                        position: absolute;
                        top: 50%;
                        left: 50%;
                        transform: translate3d(-40%, -50%, 0);
                      }
                      #frame.dnb-vimeo-activated .dnb-vimeo-playbtn {
                        display: none;
                      }
                    </style>
                    <div id="frame">
                      <slot name="poster">
                        <img
                          id="posterImage"
                          src="${DnbVimeo.#transparentPixel}"
                          alt=""
                          decoding="async"
                        />
                      </slot>
                      <button class="dnb-vimeo-playbtn" type="button"></button>
                    </div>
                  `;

        this.#frame = shadow.querySelector<HTMLDivElement>('#frame')!;
        this.#playButton =
          shadow.querySelector<HTMLButtonElement>('.dnb-vimeo-playbtn')!;
        this.#img = shadow.querySelector<HTMLImageElement>('#posterImage')!;
      }

      // A 1x1 transparent GIF so the placeholder `<img>` always has a valid
      // `src` — an absent/empty src renders as a "broken image" glyph in some
      // browsers. Without a local poster, `:host`'s black background shows
      // through as the neutral placeholder.
      static readonly #transparentPixel =
        'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';

      connectedCallback(): void {
        this.addEventListener('click', () => this.#addIframe());
      }

      attributeChangedCallback(
        name: string,
        oldVal: string | null,
        newVal: string | null,
      ): void {
        if (name !== 'videoid' || oldVal === newVal) return;

        this.#setupPlaceholder();

        if (this.#frame.classList.contains('dnb-vimeo-activated')) {
          this.#frame.classList.remove('dnb-vimeo-activated');
          this.shadowRoot?.querySelector('iframe')?.remove();
          this.#iframeLoaded = false;
        }
      }

      #addIframe(): void {
        if (this.#iframeLoaded) return;

        const srcUrl = new URL(
          `https://player.vimeo.com/video/${this.videoId}`,
        );
        srcUrl.searchParams.set('dnt', '1');
        if (this.videoHash) {
          srcUrl.searchParams.set('h', this.videoHash);
        }
        if (this.videoStartAt) {
          srcUrl.hash = `t=${this.videoStartAt}`;
        }

        const iframe = document.createElement('iframe');
        iframe.setAttribute(
          'allow',
          'accelerometer; autoplay; encrypted-media; fullscreen; gyroscope; picture-in-picture',
        );
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('title', `${this.videoPlay}: ${this.videoTitle}`);
        iframe.src = srcUrl.toString();

        this.#frame.append(iframe);
        this.#frame.classList.add('dnb-vimeo-activated');
        this.#iframeLoaded = true;
      }

      #setupPlaceholder(): void {
        if (!this.videoId) return;

        const label = `${this.videoPlay}: ${this.videoTitle}`;
        this.#playButton.setAttribute('aria-label', label);
        this.setAttribute('title', label);
        this.#img.setAttribute('alt', label);
      }
    }

    customElements.define('dnb-vimeo', DnbVimeo);
  }
</script>
