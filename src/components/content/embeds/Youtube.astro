---
// Astro wrapper around the `dnb-youtube` web component (see
// YoutubeScript.astro), a TypeScript port of
// https://github.com/paulirish/lite-youtube-embed — a click-to-load YouTube
// facade that shows a locally cached poster (or a neutral placeholder) and
// loads the real `youtube-nocookie.com` iframe only after a click. Mirrors
// `Vimeo.astro`.
import YoutubeScript from '@components/content/embeds/YoutubeScript.astro';

type Props = {
  /** YouTube video id, e.g. `dQw4w9WgXcQ` for https://youtu.be/dQw4w9WgXcQ */
  videoid: string;
  /** Accessible title used for the play button, iframe title, and gradient overlay. */
  title?: string | undefined;
  /** Label prefixed to the title, e.g. "Play: <title>". Defaults to "Play". */
  playLabel?: string | undefined;
  /** Extra YouTube player URL params passed through as-is, e.g. "start=30". */
  params?: string | undefined;
  class?: string;
};

const { videoid, title, playLabel, params, class: className } = Astro.props;
---

<YoutubeScript />
<dnb-youtube
  videoid={videoid}
  videotitle={title}
  videoplay={playLabel}
  params={params}
  class={className}
>
  <slot name="poster" />
</dnb-youtube>
