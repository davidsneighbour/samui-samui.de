---
import FormattedDate from '@components/FormattedDate.astro';
import TagBadges from '@components/TagBadges.astro';
import { cn } from '@utils/cn';

interface Props {
  date?: Date | undefined;
  updatedDate?: Date | undefined;
  tags?: string[] | undefined;
  extended?: boolean | undefined;
  class?: string | undefined;
}

const {
  date,
  updatedDate,
  tags,
  extended = false,
  class: className,
} = Astro.props as Props;
const hasTags = tags && tags.length > 0;
const hasDates = date || updatedDate;
const hasMeta = date || updatedDate || hasTags;
---

{hasMeta && (
  <div
    class={cn(
      'flex flex-col items-start gap-2 text-left text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:gap-4',
      className,
    )}
  >
    {hasDates && (
      <div class="flex flex-col items-start gap-1">
        {date && (
          <FormattedDate
            date={date}
            extended={extended}
          />
        )}
        {updatedDate && (
          <span class="italic">
            Zuletzt aktualisiert am{' '}
            <FormattedDate
              date={updatedDate}
              extended={extended}
            />
          </span>
        )}
      </div>
    )}
    {hasTags && (
      <TagBadges
        tags={tags}
        class="sm:justify-end"
      />
    )}
  </div>
)}
