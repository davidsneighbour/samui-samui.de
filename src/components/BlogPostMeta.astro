---
import FormattedDate from '@components/FormattedDate.astro';
import ThemaBadges from '@components/ThemaBadges.astro';
import Tooltip from '@components/ui/tooltip.astro';
import { CalendarCheck, CalendarDays } from '@lucide/astro';
import { cn } from '@utils/cn';
import { formatDate } from '@utils/dates';

interface Props {
  date?: Date | undefined;
  updatedDate?: Date | undefined;
  themen?: string[] | undefined;
  extended?: boolean | undefined;
  class?: string | undefined;
}

const {
  date,
  updatedDate,
  themen,
  extended = false,
  class: className,
} = Astro.props as Props;
const hasThemen = themen && themen.length > 0;
const hasDates = date || updatedDate;
const hasMeta = date || updatedDate || hasThemen;
const updatedDateLabel = updatedDate
  ? `Zuletzt aktualisiert am ${formatDate(updatedDate, { extended })}`
  : undefined;
---

{hasMeta && (
  <div
    class={cn(
      'flex flex-col items-start gap-2 text-left text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:gap-4',
      className,
    )}
  >
    {hasDates && (
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 leading-none">
        {date && (
          <span class="inline-flex items-center gap-2 leading-none [&_svg]:block [&_time]:leading-none">
            <CalendarDays
              class="size-4 shrink-0"
              aria-hidden="true"
            />
            <FormattedDate
              date={date}
              extended={extended}
            />
          </span>
        )}
        {updatedDateLabel && (
          <Tooltip
            content={updatedDateLabel}
            triggerClass="size-6"
          >
            <CalendarCheck
              slot="trigger"
              class="size-4"
              aria-hidden="true"
            />
          </Tooltip>
        )}
      </div>
    )}
    {hasThemen && (
      <ThemaBadges
        themen={themen}
        class="sm:justify-end"
      />
    )}
  </div>
)}
