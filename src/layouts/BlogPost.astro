---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import VimeoScript from '@components/content/embeds/VimeoScript.astro';
import YoutubeScript from '@components/content/embeds/YoutubeScript.astro';
import BlogPostMeta from '@components/content/post/BlogPostMeta.astro';
import BlogPostTitle from '@components/content/post/BlogPostTitle.astro';
import PostCover from '@components/content/post/PostCover.astro';
import PostTaxonomyGroups from '@components/content/post/PostTaxonomyGroups.astro';
import SocialShare from '@components/content/post/SocialShare.astro';
import Giscus from '@components/features/comments/Giscus.astro';
import Footer from '@components/layout/footer/Footer.astro';
import BaseHead from '@components/layout/head/BaseHead.astro';
import Header from '@components/layout/header/Header.astro';
import Breadcrumbs from '@components/layout/navigation/Breadcrumbs.astro';
import Separator from '@components/ui/separator.astro';
import type { ResolvedPostCover } from '@utils/covers';
import { formatDate, getPostDateParts } from '@utils/dates';
import { proseClasses } from '@utils/prose';
import type { PostReadingTime } from '@utils/reading-time';
import { humanize } from '@utils/slugify';
import type { PostTaxonomyGroup } from '@utils/taxonomies/entities';
import type { ImageMetadata } from 'astro';

const [authorFooter] = await getCollection(
  'sitewide',
  ({ id }) => id === 'authorfooter',
);
const AuthorBio = authorFooter
  ? (await render(authorFooter)).Content
  : undefined;

type Props = {
  title: string;
  readingTime?: PostReadingTime | undefined;
  description?: string | undefined;
  pubDate?: Date | undefined;
  updatedDate?: Date | undefined;
  cover?: ResolvedPostCover | undefined;
  heroImage?: ImageMetadata | string | undefined;
  date?: Date | undefined;
  lastmod?: Date | undefined;
  featured_image?: ImageMetadata | string | undefined;
  postUrl?: string | undefined;
  newerPost?: PostNavigationItem | undefined;
  olderPost?: PostNavigationItem | undefined;
  relatedPosts?: RelatedPostItem[] | undefined;
  taxonomies?: PostTaxonomyGroup[] | undefined;
  themen?: string[] | undefined;
  hasVimeo?: boolean | undefined;
  hasYoutube?: boolean | undefined;
};

type RelatedPostItem = PostNavigationItem & {
  date: Date;
  description?: string | undefined;
};

type PostNavigationItem = {
  href: string;
  title: string;
};

const {
  title,
  readingTime,
  description,
  pubDate,
  updatedDate,
  cover,
  heroImage,
  date,
  lastmod,
  featured_image,
  postUrl,
  newerPost,
  olderPost,
  relatedPosts = [],
  taxonomies = [],
  themen,
  hasVimeo = false,
  hasYoutube = false,
} = Astro.props as Props;
const metaDescription = description ?? title;
const publishedOn = date ?? pubDate;
const updatedOn = lastmod ?? updatedDate;
const hero = featured_image ?? heroImage;
const postCover: ResolvedPostCover | undefined =
  cover ??
  (hero
    ? {
        alt: title,
        legacyOverride: 'auto',
        optimized: typeof hero !== 'string',
        src: hero,
        type: 'image',
      }
    : undefined);
const metaImage =
  postCover?.type === 'image' &&
  postCover.optimized &&
  typeof postCover.src !== 'string'
    ? postCover.src
    : undefined;
const postThemen = themen ?? [];
const publishedYear = publishedOn
  ? getPostDateParts(publishedOn).year
  : undefined;
---

<html
  lang="de"
  class="dark"
>
  <head>
    <BaseHead
      title={title}
      description={metaDescription}
      image={metaImage}
    />
    <ClientRouter />
  </head>

  <body>
    <Header />
    <main
      id="main"
      tabindex="-1"
      class="mx-auto max-w-4xl px-4 py-8"
    >
      <article
        class="cover-card rounded-(--radius) border-border dark:border-transparent bg-card text-card-foreground"
      >
        {postCover && (
          <PostCover
            cover={postCover}
            eager
            figureClass="m-0 w-full"
            imageClass="block h-auto w-full"
            captionClass="px-4 pt-2 text-center text-xs text-muted-foreground sm:px-8"
          />
        )}
        <div class="px-4 py-8 sm:px-8">
          <div class="mx-auto max-w-(--reading-measure)">
            <div class="text-center">
              <BlogPostTitle
                title={title}
                href={postUrl}
                level="h1"
              />
            </div>
            <BlogPostMeta
              date={publishedOn}
              readingTime={readingTime}
              updatedDate={updatedOn}
              themen={themen}
              extended
              class="mb-4 mt-3"
            />
            <Separator />
            {publishedYear && postUrl && (
              <Breadcrumbs
                class="mb-4 mt-4 text-left"
                items={[
                  { href: '/', label: 'Startseite' },
                  {
                    href: `/archiv/${publishedYear}/`,
                    label: String(publishedYear),
                  },
                  { href: postUrl, label: title },
                ]}
              />
            )}
            <PostTaxonomyGroups groups={taxonomies} />
            {publishedOn && (
              <span
                class="sr-only"
                data-pagefind-filter={`Year:${getPostDateParts(publishedOn).year}`}
                data-pagefind-meta={`date:${formatDate(publishedOn)}`}
              />
            )}
            {postThemen.length > 0 && (
              <span
                class="sr-only"
                data-pagefind-meta={`themen:${postThemen.map(humanize).join(', ')}`}
              />
            )}
            {postThemen.map((thema) => (
              <span
                class="sr-only"
                data-pagefind-filter={`Thema:${humanize(thema)}`}
              />
            ))}
            {hasVimeo && <VimeoScript />}
            {hasYoutube && <YoutubeScript />}
          </div>
          <div class:list={[proseClasses, 'prose-reading']}>
            <slot />
          </div>
        </div>
        {relatedPosts.length > 0 && (
          <nav
            aria-label="Verwandte Beiträge"
            data-pagefind-ignore
            class="border-t border-card-foreground/10 px-4 py-8 sm:px-8"
          >
            <h2 class="mb-4 text-xl">Verwandte Beiträge</h2>
            <ul class="grid gap-4 sm:grid-cols-2">
              {relatedPosts.map((related) => (
                <li class="min-w-0">
                  <time
                    datetime={related.date.toISOString()}
                    class="mb-1 block text-xs text-muted-foreground"
                  >
                    {formatDate(related.date)}
                  </time>
                  <a
                    href={related.href}
                    class="block break-words rounded-[calc(var(--radius)-4px)] text-link hover:underline focus-visible:focus-ring"
                  >
                    {related.title}
                  </a>
                  {related.description?.trim() && (
                    <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">
                      {related.description}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        )}
        {(newerPost || olderPost) && (
          <div class="border-t border-card-foreground/10 px-4 py-6 sm:px-8">
            <nav
              class="grid gap-4 sm:grid-cols-2"
              aria-label="Beitragsnavigation"
            >
              {newerPost && (
                <a
                  href={newerPost.href}
                  class="group min-w-0 rounded-[calc(var(--radius)-4px)] text-left focus-visible:focus-ring"
                >
                  <span class="block text-xs text-muted-foreground">
                    ← Neuerer Beitrag
                  </span>
                  <span class="mt-1 block break-words text-link group-hover:underline">
                    {newerPost.title}
                  </span>
                </a>
              )}
              {!newerPost && olderPost && (
                <span class="hidden sm:block" aria-hidden="true" />
              )}
              {olderPost && (
                <a
                  href={olderPost.href}
                  class="group min-w-0 rounded-[calc(var(--radius)-4px)] text-left focus-visible:focus-ring sm:text-right"
                >
                  <span class="block text-xs text-muted-foreground">
                    Älterer Beitrag →
                  </span>
                  <span class="mt-1 block break-words text-link group-hover:underline">
                    {olderPost.title}
                  </span>
                </a>
              )}
            </nav>
          </div>
        )}
        {authorFooter && AuthorBio && (
          <div class="border-t border-card-foreground/10 px-4 py-6 sm:px-8">
            <div class="mx-auto max-w-3xl">
              {authorFooter.data.image && (
                <Image
                  src={authorFooter.data.image}
                  alt={authorFooter.data.imagetitle ?? ''}
                  width={480}
                  height={480}
                  class="mb-6 block aspect-square w-full rounded-[calc(var(--radius)-4px)] object-cover outline outline-1 -outline-offset-1 outline-black/10 min-[600px]:float-left min-[600px]:mb-4 min-[600px]:mr-6 min-[600px]:w-1/3"
                />
              )}
              <div class="prose prose-sm prose-neutral max-w-none text-card-foreground prose-headings:font-bold prose-headings:text-card-foreground prose-a:text-link prose-a:underline prose-a:decoration-link/40 prose-a:decoration-1 prose-a:underline-offset-2 prose-a:transition-colors prose-a:duration-150 prose-a:hover:decoration-link">
                <AuthorBio />
              </div>
              <div class="clear-both" aria-hidden="true" />
            </div>
          </div>
        )}
        <div class="border-t border-card-foreground/10 px-4 py-8 sm:px-8">
          <SocialShare
            title={title}
            url={new URL(Astro.url.pathname, Astro.site)}
          />
          <Giscus />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
