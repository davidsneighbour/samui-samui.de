---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import FormattedDate from '@components/FormattedDate.astro';
import Giscus from '@components/Giscus.astro';
import Header from '@components/Header.astro';
import SocialShare from '@components/SocialShare.astro';
import Separator from '@components/ui/separator.astro';
import { proseClasses } from '@utils/prose';
import { humanize, slugify } from '@utils/slugify';
import type { ImageMetadata } from 'astro';

const [authorFooter] = await getCollection(
  'sitewide',
  ({ id }) => id === 'authorfooter',
);
const AuthorBio = authorFooter
  ? (await render(authorFooter)).Content
  : undefined;

type Props = {
  title: string;
  description?: string | undefined;
  pubDate?: Date | undefined;
  updatedDate?: Date | undefined;
  heroImage?: ImageMetadata | string | undefined;
  date?: Date | undefined;
  lastmod?: Date | undefined;
  featured_image?: ImageMetadata | string | undefined;
  tags?: string[] | undefined;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  date,
  lastmod,
  featured_image,
  tags,
} = Astro.props as Props;
const metaDescription = description ?? title;
const publishedOn = date ?? pubDate;
const updatedOn = lastmod ?? updatedDate;
const hero = featured_image ?? heroImage;
---

<html lang="de">
  <head>
    <BaseHead
      title={title}
      description={metaDescription}
    />
  </head>

  <body>
    <Header />
    <main class="mx-auto max-w-4xl px-4 py-8">
      <article
        class="overflow-hidden rounded-(--radius) bg-card text-card-foreground"
      >
        {hero && (
          <div class="w-full">
            {typeof hero === "string" ? (
              <img
                src={hero}
                alt=""
                class="block w-full"
              />
            ) : (
              <Image
                width={1020}
                height={510}
                src={hero}
                alt=""
                class="block w-full"
              />
            )}
          </div>
        )}
        <div class="px-4 py-8 sm:px-8">
          <div class="mb-8 text-center">
            <p class="mb-2 text-sm text-muted-foreground">
              {publishedOn && <FormattedDate date={publishedOn} />}
              {updatedOn && (
                  <span class="block italic">
                    Last updated on <FormattedDate date={updatedOn} />
                  </span>
                )}
            </p>
            <h1 class="mb-4 text-3xl font-normal sm:text-4xl">{title}</h1>
            {tags && tags.length > 0 && (
              <p class="mb-4 text-sm text-muted-foreground">
                {tags.map((tag, index) => (
                  <>
                    {index > 0 && ' / '}
                    <a
                      href={`/tags/${slugify(tag)}/`}
                      class="text-link hover:underline"
                    >
                      {humanize(tag)}
                    </a>
                  </>
                ))}
              </p>
            )}
            <Separator />
          </div>
          <div class={proseClasses}>
            <slot />
          </div>
        </div>
        {authorFooter && AuthorBio && (
          <div class="border-t border-card-foreground/10 bg-muted px-4 py-8 sm:px-8">
            <div class="mx-auto flex max-w-2xl flex-col gap-4 sm:flex-row">
              {authorFooter.data.image && (
                <Image
                  src={authorFooter.data.image}
                  alt={authorFooter.data.imagetitle ?? ''}
                  width={120}
                  height={120}
                  class="mx-auto block h-24 w-24 shrink-0 rounded-full object-cover sm:mx-0"
                />
              )}
              <div class="prose prose-sm prose-neutral max-w-none text-card-foreground prose-headings:font-normal prose-headings:text-card-foreground prose-a:text-link prose-a:no-underline prose-a:hover:underline">
                <AuthorBio />
              </div>
            </div>
          </div>
        )}
        <div class="border-t border-card-foreground/10 px-4 py-8 sm:px-8">
          <SocialShare
            title={title}
            url={new URL(Astro.url.pathname, Astro.site)}
          />
          <Giscus />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
