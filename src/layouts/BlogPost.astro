---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import FormattedDate from '@components/FormattedDate.astro';
import Giscus from '@components/Giscus.astro';
import Header from '@components/Header.astro';
import PostCover from '@components/PostCover.astro';
import SocialShare from '@components/SocialShare.astro';
import Separator from '@components/ui/separator.astro';
import type { ResolvedPostCover } from '@utils/covers';
import { proseClasses } from '@utils/prose';
import { humanize, slugify } from '@utils/slugify';
import type { ImageMetadata } from 'astro';

const [authorFooter] = await getCollection(
  'sitewide',
  ({ id }) => id === 'authorfooter',
);
const AuthorBio = authorFooter
  ? (await render(authorFooter)).Content
  : undefined;

type Props = {
  title: string;
  description?: string | undefined;
  pubDate?: Date | undefined;
  updatedDate?: Date | undefined;
  cover?: ResolvedPostCover | undefined;
  heroImage?: ImageMetadata | string | undefined;
  date?: Date | undefined;
  lastmod?: Date | undefined;
  featured_image?: ImageMetadata | string | undefined;
  newerPost?: PostNavigationItem | undefined;
  olderPost?: PostNavigationItem | undefined;
  tags?: string[] | undefined;
};

type PostNavigationItem = {
  href: string;
  title: string;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  cover,
  heroImage,
  date,
  lastmod,
  featured_image,
  newerPost,
  olderPost,
  tags,
} = Astro.props as Props;
const metaDescription = description ?? title;
const publishedOn = date ?? pubDate;
const updatedOn = lastmod ?? updatedDate;
const hero = featured_image ?? heroImage;
const postCover: ResolvedPostCover | undefined =
  cover ??
  (hero
    ? {
        alt: title,
        optimized: typeof hero !== 'string',
        src: hero,
        type: 'image',
      }
    : undefined);
const metaImage =
  postCover?.optimized && typeof postCover.src !== 'string'
    ? postCover.src
    : undefined;
---

<html lang="de">
  <head>
    <BaseHead
      title={title}
      description={metaDescription}
      image={metaImage}
    />
  </head>

  <body>
    <Header />
    <main class="mx-auto max-w-4xl px-4 py-8">
      <article
        class="overflow-hidden rounded-(--radius) bg-card text-card-foreground"
      >
        {postCover && (
          <PostCover
            cover={postCover}
            eager
            figureClass="m-0 w-full"
            imageClass="block h-auto w-full"
            captionClass="px-4 pt-2 text-center text-xs text-muted-foreground sm:px-8"
          />
        )}
        <div class="px-4 py-8 sm:px-8">
          <div class="mb-8 text-center">
            <p class="mb-2 text-sm text-muted-foreground">
              {publishedOn && (
                <FormattedDate
                  date={publishedOn}
                  extended
                />
              )}
              {updatedOn && (
                  <span class="block italic">
                    Zuletzt aktualisiert am{' '}
                    <FormattedDate
                      date={updatedOn}
                      extended
                    />
                  </span>
                )}
            </p>
            <h1 class="mb-4 text-3xl font-normal sm:text-4xl">{title}</h1>
            {tags && tags.length > 0 && (
              <p class="mb-4 text-sm text-muted-foreground">
                {tags.map((tag, index) => (
                  <>
                    {index > 0 && ' / '}
                    <a
                      href={`/tags/${slugify(tag)}/`}
                      class="text-link hover:underline"
                    >
                      {humanize(tag)}
                    </a>
                  </>
                ))}
              </p>
            )}
            <Separator />
          </div>
          <div class={proseClasses}>
            <slot />
          </div>
        </div>
        {(newerPost || olderPost) && (
          <div class="border-t border-card-foreground/10 px-4 py-6 sm:px-8">
            <nav
              class="grid gap-4 sm:grid-cols-2"
              aria-label="Beitragsnavigation"
            >
              {newerPost && (
                <a
                  href={newerPost.href}
                  class="group min-w-0 rounded-[calc(var(--radius)-4px)] text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                >
                  <span class="block text-xs text-muted-foreground">
                    ← Neuerer Beitrag
                  </span>
                  <span class="mt-1 block break-words text-link group-hover:underline">
                    {newerPost.title}
                  </span>
                </a>
              )}
              {!newerPost && olderPost && (
                <span
                  class="hidden sm:block"
                  aria-hidden="true"
                />
              )}
              {olderPost && (
                <a
                  href={olderPost.href}
                  class="group min-w-0 rounded-[calc(var(--radius)-4px)] text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 sm:text-right"
                >
                  <span class="block text-xs text-muted-foreground">
                    Älterer Beitrag →
                  </span>
                  <span class="mt-1 block break-words text-link group-hover:underline">
                    {olderPost.title}
                  </span>
                </a>
              )}
            </nav>
          </div>
        )}
        {authorFooter && AuthorBio && (
          <div class="border-t border-card-foreground/10 bg-muted px-4 py-8 sm:px-8">
            <div class="mx-auto flex max-w-2xl flex-col gap-4 sm:flex-row">
              {authorFooter.data.image && (
                <Image
                  src={authorFooter.data.image}
                  alt={authorFooter.data.imagetitle ?? ''}
                  width={120}
                  height={120}
                  class="mx-auto block h-24 w-24 shrink-0 rounded-full object-cover sm:mx-0"
                />
              )}
              <div class="prose prose-sm prose-neutral max-w-none text-card-foreground prose-headings:font-normal prose-headings:text-card-foreground prose-a:text-link prose-a:no-underline prose-a:hover:underline">
                <AuthorBio />
              </div>
            </div>
          </div>
        )}
        <div class="border-t border-card-foreground/10 px-4 py-8 sm:px-8">
          <SocialShare
            title={title}
            url={new URL(Astro.url.pathname, Astro.site)}
          />
          <Giscus />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
