---
import { Image } from 'astro:assets';
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import FormattedDate from '@components/FormattedDate.astro';
import Giscus from '@components/Giscus.astro';
import Header from '@components/Header.astro';
import SocialShare from '@components/SocialShare.astro';
import Separator from '@components/ui/separator.astro';
import type { ImageMetadata } from 'astro';

type Props = {
  title: string;
  description?: string | undefined;
  pubDate?: Date | undefined;
  updatedDate?: Date | undefined;
  heroImage?: ImageMetadata | string | undefined;
  date?: Date | undefined;
  lastmod?: Date | undefined;
  featured_image?: ImageMetadata | string | undefined;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  date,
  lastmod,
  featured_image,
} = Astro.props as Props;
const metaDescription = description ?? title;
const publishedOn = date ?? pubDate;
const updatedOn = lastmod ?? updatedDate;
const hero = featured_image ?? heroImage;
---

<html lang="de">
  <head>
    <BaseHead
      title={title}
      description={metaDescription}
    />
  </head>

  <body>
    <Header />
    <main class="mx-auto max-w-4xl px-4 py-8">
      <article
        class="overflow-hidden rounded-(--radius) bg-card text-card-foreground"
      >
        {hero && (
          <div class="w-full">
            {typeof hero === "string" ? (
              <img
                src={hero}
                alt=""
                class="block w-full"
              />
            ) : (
              <Image
                width={1020}
                height={510}
                src={hero}
                alt=""
                class="block w-full"
              />
            )}
          </div>
        )}
        <div class="px-4 py-8 sm:px-8">
          <div class="mb-8 text-center">
            <p class="mb-2 text-sm text-muted-foreground">
              {publishedOn && <FormattedDate date={publishedOn} />}
              {updatedOn && (
                  <span class="block italic">
                    Last updated on <FormattedDate date={updatedOn} />
                  </span>
                )}
            </p>
            <h1 class="mb-4 text-3xl font-normal sm:text-4xl">{title}</h1>
            <Separator />
          </div>
          <div
            class="prose prose-neutral mx-auto max-w-none prose-headings:font-normal prose-headings:text-card-foreground prose-a:text-link prose-a:no-underline prose-a:hover:underline prose-strong:text-card-foreground prose-blockquote:border-primary prose-blockquote:text-muted-foreground prose-img:rounded-(--radius)"
          >
            <slot />
          </div>
        </div>
        <div class="border-t border-card-foreground/10 px-4 py-8 sm:px-8">
          <SocialShare
            title={title}
            url={new URL(Astro.url.pathname, Astro.site)}
          />
          <Giscus />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
