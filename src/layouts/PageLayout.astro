---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '@components/BaseHead.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';

interface Props {
  title?: string;
  description?: string | undefined;
  noindex?: boolean | undefined;
  // Passed straight through to Footer.astro -- see its hideWeather prop.
  hideWeather?: boolean | undefined;
  // Set when this layout is used via an MDX page's own `<PageLayout>` JSX
  // wrapper and passed `frontmatter` from that file's YAML frontmatter.
  frontmatter?: { title: string; description?: string };
}

const {
  title,
  description,
  frontmatter,
  noindex = false,
  hideWeather = false,
} = Astro.props as Props;
const pageTitle = frontmatter?.title ?? title ?? '';
const pageDescription = frontmatter?.description ?? description;
---

<!doctype html>
<html
  lang="de"
  class="dark"
>
  <head>
    <BaseHead
      title={pageTitle}
      description={pageDescription ?? pageTitle}
      noindex={noindex}
    />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main
      id="main"
      tabindex="-1"
      class="mx-auto max-w-4xl px-4 py-8"
    >
      <article
        class="rounded-(--radius) bg-card px-4 py-8 text-card-foreground sm:px-8"
      >
        <slot name="breadcrumbs" />
        <header class="mb-8 text-center">
          <h1 class="text-3xl font-normal sm:text-4xl">{pageTitle}</h1>
        </header>
        <slot />
      </article>
    </main>
    <Footer hideWeather={hideWeather} />
    <slot name="scripts" />
  </body>
</html>
