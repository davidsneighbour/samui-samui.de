---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import { getPostUrl } from '@utils/posts';

const monthFormatter = new Intl.DateTimeFormat('de-DE', { month: 'long' });

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const years = new Set(posts.map((post) => post.data.date.getUTCFullYear()));

  return [...years].map((year) => {
    const yearPosts = posts
      .filter((post) => post.data.date.getUTCFullYear() === year)
      .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

    return {
      params: { year: String(year) },
      props: { posts: yearPosts, year },
    };
  });
}

const { year, posts } = Astro.props;

const months = new Map<number, typeof posts>();
for (const post of posts) {
  const month = post.data.date.getUTCMonth();
  const group = months.get(month);
  if (group) {
    group.push(post);
  } else {
    months.set(month, [post]);
  }
}
const sortedMonths = [...months.entries()].sort(([a], [b]) => a - b);
---

<PageLayout
  title={String(year)}
  description={`Alle Beiträge aus ${year}`}
>
  {sortedMonths.map(([month, monthPosts]) => (
      <section class="mb-6">
        <strong class="mb-2 block text-card-foreground">
          {monthFormatter.format(new Date(Date.UTC(year, month, 1)))}{' '}
          {year}
        </strong>
        <ul class="space-y-1">
          {monthPosts.map((post) => (
            <li class="text-muted-foreground">
              {post.data.date.getUTCDate()}.{' '}
              {monthFormatter.format(post.data.date)} {year} -{' '}
              <a
                href={getPostUrl(post)}
                class="text-link hover:underline"
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
</PageLayout>
