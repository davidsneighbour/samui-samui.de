---
import { getCollection, render } from 'astro:content';
import BlogList from '@components/content/blog/BlogList.astro';
import Footer from '@components/layout/footer/Footer.astro';
import BaseHead from '@components/layout/head/BaseHead.astro';
import Header from '@components/layout/header/Header.astro';
import ArchiveNav from '@components/layout/navigation/ArchiveNav.astro';
import Breadcrumbs from '@components/layout/navigation/Breadcrumbs.astro';
import { proseClasses } from '@utils/prose';
import {
  getEntityDescription,
  groupPostsByEntity,
  isPublicEntity,
} from '@utils/taxonomies/entities';

export async function getStaticPaths() {
  const [events, posts] = await Promise.all([
    getCollection('ereignisse'),
    getCollection('posts'),
  ]);

  return events.filter(isPublicEntity).map((event) => ({
    params: { slug: event.id },
    props: {
      event,
      posts: groupPostsByEntity(posts, 'ereignisse', event.id),
    },
  }));
}

const { event, posts } = Astro.props;
const description = getEntityDescription('ereignisse', event);
const { Content } = await render(event);
---

<!doctype html>
<html
  lang="de"
  class="dark"
>
  <head>
    <BaseHead
      title={event.data.title}
      description={description}
      noindex={event.data.noindex}
    />
  </head>
  <body>
    <Header />
    <main
      id="main"
      tabindex="-1"
      class="py-8"
    >
      <section>
        <Breadcrumbs
          class="mx-auto max-w-4xl px-4"
          items={[
            { href: '/', label: 'Startseite' },
            { href: '/archiv/', label: 'Archiv' },
            { href: '/archiv/ereignisse/', label: 'Ereignisse' },
            {
              href: `/archiv/ereignisse/${event.id}/`,
              label: event.data.title,
            },
          ]}
        />
        <ArchiveNav
          current="ereignisse"
          class="mx-auto mb-6 max-w-4xl px-4"
        />
        <div class="mx-auto mb-8 max-w-4xl px-4">
          <article
            class="rounded-(--radius) border border-border bg-card px-4 py-8 text-card-foreground sm:px-8 dark:border-transparent"
          >
            <header class="mx-auto max-w-(--reading-measure)">
              <h1 class="mb-4 text-2xl text-card-foreground">
                {event.data.title}
              </h1>
              <p class="text-card-foreground">{description}</p>
            </header>
            {event.body?.trim() && (
              <div class:list={[proseClasses, 'prose-reading', 'mt-8']}>
                <Content />
              </div>
            )}
          </article>
        </div>
        <BlogList
          posts={posts}
          pageNumber={1}
          totalPages={1}
        />
      </section>
    </main>
    <Footer />
  </body>
</html>
