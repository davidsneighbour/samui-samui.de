---
import { getCollection } from 'astro:content';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import FormattedDate from '@components/FormattedDate.astro';
import SiteAge from '@components/SiteAge.astro';
import Accordion from '@components/ui/accordion.astro';
import Badge from '@components/ui/badge.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { Calendar } from '@lucide/astro';
import { cn } from '@utils/cn';
import {
  formatDateDuration,
  formatMonthLong,
  formatMonthShort,
  getPostDateParts,
} from '@utils/dates';
import { groupPostsByThema } from '@utils/themen';

const [posts, themaEntries] = await Promise.all([
  getCollection('posts'),
  getCollection('themen'),
]);

const sortedByDate = [...posts].sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const oldestPost = sortedByDate[0];
if (!oldestPost) throw new Error('No posts found in the posts collection');
const siteSinceDate = '2005-01-08';
const siteAge = formatDateDuration({
  format: '%y Jahre',
  sinceDate: siteSinceDate,
});

type ActivityLevel = 'none' | 'few' | 'some' | 'many';

interface MonthCount {
  month: number;
  count: number;
  level: ActivityLevel;
}

interface YearSummary {
  year: number;
  total: number;
  months: MonthCount[];
  hasPosts: boolean;
}

const postsByYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = getPostDateParts(post.data.date).year;
  const group = postsByYear.get(year);
  if (group) {
    group.push(post);
  } else {
    postsByYear.set(year, [post]);
  }
}

const yearNumbers = [...postsByYear.keys()];
const minYear = Math.min(...yearNumbers);
const maxYear = Math.max(...yearNumbers);

// Four-step activity scale on the `primary` token -- see DESIGN.md's "Month
// activity indicator" section. Scaled per year (darkest = that year's own
// busiest month, lightest active tier = its own least-busy active month)
// rather than against the whole archive's max, so a low-volume year still
// shows internal month-to-month contrast instead of reading as uniformly
// faded next to a peak year like 2006 (#1652).
function activityLevel(
  count: number,
  yearMin: number,
  yearMax: number,
): ActivityLevel {
  if (count === 0) return 'none';
  const fraction =
    yearMax > yearMin ? (count - yearMin) / (yearMax - yearMin) : 1;
  if (fraction < 1 / 3) return 'few';
  if (fraction < 2 / 3) return 'some';
  return 'many';
}

// Walk every year in range, not just the ones with posts -- a year with
// zero posts (e.g. a gap year) still appears in the list so the archive
// reads as a continuous timeline, just unlinked (there's no /archiv/[year]/
// page for it) and with twelve empty activity dots.
const years: YearSummary[] = [];
for (let year = maxYear; year >= minYear; year--) {
  const yearPosts = postsByYear.get(year);
  if (yearPosts) {
    const monthCounts = Array.from({ length: 12 }, () => 0);
    for (const post of yearPosts) {
      const month = getPostDateParts(post.data.date).monthIndex;
      monthCounts[month] = (monthCounts[month] ?? 0) + 1;
    }
    const activeCounts = monthCounts.filter((count) => count > 0);
    const yearMin = Math.min(...activeCounts);
    const yearMax = Math.max(...activeCounts);
    years.push({
      hasPosts: true,
      months: monthCounts.map((count, month) => ({
        count,
        level: activityLevel(count, yearMin, yearMax),
        month,
      })),
      total: yearPosts.length,
      year,
    });
  } else {
    years.push({
      hasPosts: false,
      months: Array.from({ length: 12 }, (_, month) => ({
        count: 0,
        level: 'none' as const,
        month,
      })),
      total: 0,
      year,
    });
  }
}

const activityClasses = {
  few: 'bg-primary/25',
  many: 'bg-primary',
  none: 'border border-border bg-transparent',
  some: 'bg-primary/60',
} as const;

// Month anchors on /archiv/[year]/ use a zero-padded, locale-independent
// `#monat-MM` id (see src/pages/archiv/[year].astro) rather than a German
// month name, so the fragment never has to deal with umlaut slugification.
const monthAnchor = (month: number) =>
  `monat-${String(month + 1).padStart(2, '0')}`;

// The year link in each row stays outside <details>/<summary> below --
// nesting an interactive element inside <summary> is a known a11y
// anti-pattern (Chrome DevTools' Issues panel flags it). Only the "Monate
// anzeigen" toggle and its content live inside the accordion.

const themaGroups = groupPostsByThema(posts, themaEntries).sort(
  (a, b) => b.posts.length - a.posts.length,
);
// No editorial "featured topic" signal exists in the content today (see
// documentation/features/archiv.md) -- this is frequency-ranked, not hand-curated.
// Revisit once/if editorial curation is added.
const curatedThemen = themaGroups.slice(0, 12);
---

<PageLayout
  title="Archiv"
  description={`${siteAge} Leben auf Koh Samui -- durchsuche das komplette Archiv nach Jahr, Monat oder Thema.`}
>
  <Breadcrumbs
    slot="breadcrumbs"
    items={[
      { href: '/', label: 'Startseite' },
      { href: '/archiv/', label: 'Archiv' },
    ]}
  />

  <p class="-mt-4 mb-8 text-center text-lg text-muted-foreground">
    <SiteAge
      sinceDate={siteSinceDate}
      format="%y Jahre"
    />
    Leben auf Koh Samui
  </p>

  <p class="mb-8 text-card-foreground">
    Im Archiv findest du alle Beiträge seit
    {getPostDateParts(oldestPost.data.date).year}. Suche nach einem Begriff,
    wähle ein Jahr oder steige über eines der häufigsten Themen ein.
  </p>

  <dl
    class="mb-10 grid grid-cols-2 gap-4 border-y border-border py-6 sm:grid-cols-4"
  >
    <div>
      <dt class="text-sm text-muted-foreground">Beiträge</dt>
      <dd class="text-2xl font-medium text-card-foreground">{posts.length}</dd>
    </div>
    <div>
      <dt class="text-sm text-muted-foreground">Jahre im Archiv</dt>
      <dd class="text-2xl font-medium text-card-foreground">
        {postsByYear.size}
      </dd>
    </div>
    <div>
      <dt class="text-sm text-muted-foreground">Themen</dt>
      <dd class="text-2xl font-medium text-card-foreground">
        {themaGroups.length}
      </dd>
    </div>
    <div>
      <dt class="text-sm text-muted-foreground">Ältester Beitrag</dt>
      <dd class="text-2xl font-medium text-card-foreground">
        <FormattedDate date={oldestPost.data.date} />
      </dd>
    </div>
  </dl>

  <section class="mb-10">
    <h2 class="mb-2 text-lg font-medium text-card-foreground">
      Im gesamten Archiv suchen
    </h2>
    <p class="mb-3 text-sm text-muted-foreground">
      Suche nach Orten, Personen, Restaurants, Ereignissen oder Begriffen aus
      dem Inselleben.
    </p>
    <div class="pagefind-archive-search">
      <pagefind-config
        instance="archive"
        bundle-path="/pagefind/"
        base-url="/"
      ></pagefind-config>
      <pagefind-searchbox
        instance="archive"
        placeholder="Archiv durchsuchen"
        max-results="8"
        hide-shortcut
      ></pagefind-searchbox>
    </div>
  </section>

  <section class="mb-10">
    <h2 class="mb-4 text-lg font-medium text-card-foreground">Nach Jahr</h2>
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      {years.map((yearSummary) => (
          <li class="rounded-(--radius) border border-border/60 bg-card p-3">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              {yearSummary.hasPosts ? (
                <a
                  href={`/archiv/${yearSummary.year}/`}
                  class="text-base font-medium text-card-foreground hover:text-link hover:underline"
                >
                  {yearSummary.year}
                </a>
              ) : (
                <span class="text-base font-medium text-muted-foreground">
                  {yearSummary.year}
                </span>
              )}
              <span class="text-xs text-muted-foreground">
                {yearSummary.hasPosts
                  ? `${yearSummary.total} ${yearSummary.total === 1 ? 'Beitrag' : 'Beiträge'}`
                  : 'Keine Beiträge'}
              </span>
              <span
                class="ml-auto flex items-center gap-1"
                aria-hidden="true"
              >
                {yearSummary.months.map((monthCount) => (
                    <span
                      class={cn(
                        'month-dot size-2.5 rounded-full',
                        activityClasses[monthCount.level],
                      )}
                      data-month={formatMonthShort(
                        new Date(
                          Date.UTC(yearSummary.year, monthCount.month, 1),
                        ),
                      )}
                    />
                  ))}
              </span>
            </div>
            {yearSummary.hasPosts && (
              <Accordion class="border-b-0">
                <span
                  slot="summary"
                  class="inline-flex items-center gap-1.5"
                >
                  <Calendar
                    class="size-3.5"
                    aria-hidden="true"
                  />
                  Monate anzeigen
                </span>
                <ul class="grid grid-cols-2 gap-x-4 gap-y-1 pl-1">
                  {yearSummary.months
                    .filter((monthCount) => monthCount.count > 0)
                    .map((monthCount) => (
                        <li>
                          <a
                            href={`/archiv/${yearSummary.year}/#${monthAnchor(monthCount.month)}`}
                            class="flex items-baseline justify-between gap-2 text-sm text-muted-foreground hover:text-link hover:underline"
                          >
                            <span>
                              {formatMonthLong(
                                new Date(
                                  Date.UTC(
                                    yearSummary.year,
                                    monthCount.month,
                                    1,
                                  ),
                                ),
                              )}
                            </span>
                            <span>{monthCount.count}</span>
                          </a>
                        </li>
                      ))}
                </ul>
              </Accordion>
            )}
          </li>
        ))}
    </ul>
  </section>

  <section>
    <h2 class="mb-1 text-lg font-medium text-card-foreground">
      Womit möchtest du anfangen?
    </h2>
    <p class="mb-4 text-sm text-muted-foreground">
      Eine Auswahl häufig verwendeter Themen aus {postsByYear.size} Jahren
      Archiv.
    </p>
    <ul class="flex flex-wrap gap-2">
      {curatedThemen.map((thema) => (
          <li>
            <Badge
              href={`/themen/${thema.slug}/`}
              variant="muted"
              aria-label={`${thema.posts.length} Beiträge zum Thema ${thema.title}`}
            >
              {thema.title.toLocaleUpperCase('de-DE')} · {thema.posts.length}
            </Badge>
          </li>
        ))}
    </ul>
    <a
      href="/themen/"
      class="mt-4 inline-block text-sm text-link hover:underline"
    >
      Alle Themen ansehen →
    </a>
  </section>
</PageLayout>
