---
import { getCollection } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import BlogList from '@components/BlogList.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import {
  getEntityDescription,
  groupPostsByEntity,
  isPublicEntity,
} from '@utils/taxonomies/entities';

export async function getStaticPaths() {
  const [people, posts] = await Promise.all([
    getCollection('leute'),
    getCollection('posts'),
  ]);

  return people.filter(isPublicEntity).map((person) => {
    const matchingPosts = groupPostsByEntity(posts, 'leute', person.id);

    return {
      params: { slug: person.id },
      props: { person, posts: matchingPosts },
    };
  });
}

const { person, posts } = Astro.props;
const description = getEntityDescription('leute', person);
---

<!doctype html>
<html
  lang="de"
  class="dark"
>
  <head>
    <BaseHead
      title={person.data.title}
      description={description}
      noindex={person.data.noindex}
    />
  </head>
  <body>
    <Header />
    <main
      id="main"
      tabindex="-1"
      class="py-8"
    >
      <section>
        <h1
          class="mx-auto mb-4 max-w-4xl px-4 text-2xl font-normal text-foreground"
        >
          {person.data.title}
        </h1>
        <p class="mx-auto mb-8 max-w-4xl px-4 text-muted-foreground">
          {description}
        </p>
        <BlogList
          posts={posts}
          pageNumber={1}
          totalPages={1}
        />
      </section>
    </main>
    <Footer />
  </body>
</html>
