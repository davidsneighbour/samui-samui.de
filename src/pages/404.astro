---
import PageLayout from '@layouts/PageLayout.astro';
---

<PageLayout
  title="Seite nicht gefunden"
  description="Diese Seite konnte nicht gefunden werden."
  hideWeather
>
  <p class="text-card-foreground">
    Die gesuchte Seite existiert nicht (mehr). Vielleicht hilft die
    <a
      href="/suche/"
      class="text-link hover:underline"
      >Suche</a
    >
    oder die
    <a
      href="/archiv/"
      class="text-link hover:underline"
      >Archivübersicht</a
    >
    weiter, oder zurück zur
    <a
      href="/"
      class="text-link hover:underline"
      >Startseite</a
    >.
  </p>
</PageLayout>
