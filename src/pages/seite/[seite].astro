---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import BlogList from '@components/BlogList.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import setup from '@data/setup.json';
import { orderPostsForHomepage } from '@utils/homepage-posts';

export async function getStaticPaths() {
  const chronologicalPosts = (await getCollection('posts')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  const posts = orderPostsForHomepage(chronologicalPosts);
  const totalPages = Math.max(1, Math.ceil(posts.length / setup.postsPerPage));

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const pageNumber = index + 2;
    const start = (pageNumber - 1) * setup.postsPerPage;
    const end = start + setup.postsPerPage;

    return {
      params: { seite: String(pageNumber) },
      props: {
        pageNumber,
        posts: posts.slice(start, end),
        totalPages,
      },
    };
  });
}

interface Props {
  posts: CollectionEntry<'posts'>[];
  pageNumber: number;
  totalPages: number;
}

const { posts, pageNumber, totalPages } = Astro.props as Props;

const showArchivePrompt = pageNumber >= 5;
---

<!doctype html>
<html
  lang="en"
  class="dark"
>
  <head>
    <BaseHead
      title={`${setup.title} - Seite ${pageNumber}`}
      description={setup.description}
    />
  </head>
  <body>
    <Header />
    <main
      id="main"
      tabindex="-1"
    >
      <section>
        {showArchivePrompt && (
          <p class="mx-auto mb-8 max-w-4xl rounded-(--radius) bg-card px-4 py-4 text-sm text-card-foreground sm:px-6">
            Du suchst etwas Bestimmtes? Im{' '}
            <a
              href="/archiv/"
              class="text-link hover:underline"
            >
              Archiv
            </a>{' '}
            kannst du direkt zu einem Jahr oder Monat springen.
          </p>
        )}
        <BlogList
          posts={posts}
          pageNumber={pageNumber}
          totalPages={totalPages}
        />
      </section>
    </main>
    <Footer />
  </body>
</html>
