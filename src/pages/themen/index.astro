---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import { groupPostsByThema } from '@utils/themen';

const [posts, themaEntries] = await Promise.all([
  getCollection('posts'),
  getCollection('themen'),
]);

const themaGroups = groupPostsByThema(posts, themaEntries);

const byFrequency = [...themaGroups].sort(
  (a, b) => b.posts.length - a.posts.length,
);

interface LetterGroup {
  letter: string;
  themen: typeof themaGroups;
}

const byLetterMap = new Map<string, typeof themaGroups>();
for (const thema of [...themaGroups].sort((a, b) =>
  a.title.localeCompare(b.title, 'de-DE'),
)) {
  const letter = thema.title.charAt(0).toLocaleUpperCase('de-DE');
  const group = byLetterMap.get(letter);
  if (group) {
    group.push(thema);
  } else {
    byLetterMap.set(letter, [thema]);
  }
}
const byLetter: LetterGroup[] = [...byLetterMap.entries()]
  .sort(([a], [b]) => a.localeCompare(b, 'de-DE'))
  .map(([letter, themen]) => ({ letter, themen }));
---

<PageLayout
  title="Themen"
  description={`Alle ${themaGroups.length} Themen des Archivs -- alphabetisch oder nach Häufigkeit.`}
>
  <p class="mb-8 text-card-foreground">
    {themaGroups.length}
    Themen aus 21 Jahren Archiv, sortierbar nach Häufigkeit oder Alphabet.
  </p>

  <nav
    aria-label="Ansicht wählen"
    class="mb-10 flex gap-4 border-y border-border py-4 text-sm"
  >
    <a
      href="#haeufigkeit"
      class="text-link hover:underline"
    >
      Häufig verwendet
    </a>
    <a
      href="#alphabet"
      class="text-link hover:underline"
    >
      Alphabetisch
    </a>
  </nav>

  <section
    id="haeufigkeit"
    class="mb-12"
  >
    <h2 class="mb-4 text-lg font-medium text-card-foreground">
      Häufig verwendet
    </h2>
    <ul class="flex flex-wrap gap-x-4 gap-y-2">
      {byFrequency.map((thema) => (
          <li>
            <a
              href={`/themen/${thema.slug}/`}
              class="text-sm text-link hover:underline"
            >
              {thema.title} <span class="text-muted-foreground">({thema.posts.length})</span>
            </a>
          </li>
        ))}
    </ul>
  </section>

  <section id="alphabet">
    <h2 class="mb-4 text-lg font-medium text-card-foreground">Alphabetisch</h2>
    {byLetter.map(({ letter, themen }) => (
        <div class="mb-6">
          <h3 class="mb-2 text-sm font-medium text-muted-foreground">
            {letter}
          </h3>
          <ul class="flex flex-wrap gap-x-4 gap-y-2">
            {themen.map((thema) => (
                <li>
                  <a
                    href={`/themen/${thema.slug}/`}
                    class="text-sm text-link hover:underline"
                  >
                    {thema.title}{' '}
                    <span class="text-muted-foreground">({thema.posts.length})</span>
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))}
  </section>
</PageLayout>
