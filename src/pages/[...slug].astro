---
import { getCollection, render } from 'astro:content';
import BlogPost from '@layouts/BlogPost.astro';
import { getPostCover } from '@utils/covers';
import { getPostUrl } from '@utils/posts';
import { resolvePostTaxonomyGroups } from '@utils/taxonomies/entities';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return posts.map((post, index) => {
    const url = getPostUrl(post);
    const newerPost = posts[index - 1];
    const olderPost = posts[index + 1];

    return {
      params: { slug: url.replace(/^\/|\/$/g, '') },
      props: {
        newerPost: newerPost
          ? {
              href: getPostUrl(newerPost),
              title: newerPost.data.title,
            }
          : undefined,
        olderPost: olderPost
          ? {
              href: getPostUrl(olderPost),
              title: olderPost.data.title,
            }
          : undefined,
        post,
      },
    };
  });
}

const { newerPost, olderPost, post } = Astro.props;
const postUrl = getPostUrl(post);
const { Content } = await render(post);
const cover = await getPostCover(post);
const [leute, orte, ereignisse, themen] = await Promise.all([
  getCollection('leute'),
  getCollection('orte'),
  getCollection('ereignisse'),
  getCollection('themen'),
]);
const taxonomies = resolvePostTaxonomyGroups({
  ereignisse,
  leute,
  orte,
  post,
  themen,
});
// Raw markdown source (not the rendered HTML) — cheap to grep and lets
// BlogPost skip shipping the dnb-vimeo/dnb-youtube definitions on the posts
// that don't embed the corresponding video.
const hasVimeo = post.body?.includes('dnb-vimeo') ?? false;
const hasYoutube = post.body?.includes('dnb-youtube') ?? false;
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  cover={cover}
  date={post.data.date}
  lastmod={post.data.lastmod}
  featured_image={post.data.featured_image}
  postUrl={postUrl}
  newerPost={newerPost}
  olderPost={olderPost}
  taxonomies={taxonomies}
  themen={post.data.themen}
  hasVimeo={hasVimeo}
  hasYoutube={hasYoutube}
>
  <Content />
</BlogPost>
