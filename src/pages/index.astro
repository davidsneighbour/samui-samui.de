---
import { getCollection } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import BlogList from '@components/BlogList.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import setup from '@data/setup.json';
import { orderPostsForHomepage } from '@utils/homepage-posts';

const chronologicalPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const posts = orderPostsForHomepage(chronologicalPosts);
const totalPages = Math.max(1, Math.ceil(posts.length / setup.postsPerPage));
const firstPagePosts = posts.slice(0, setup.postsPerPage);
---

<!doctype html>
<html
  lang="en"
  class="dark"
>
  <head>
    <BaseHead
      title={setup.title}
      description={setup.description}
    />
  </head>
  <body>
    <Header />
    <main
      id="main"
      tabindex="-1"
      class="py-8"
    >
      <section>
        <BlogList
          posts={firstPagePosts}
          pageNumber={1}
          totalPages={totalPages}
          featuredFirst
        />
      </section>
    </main>
    <Footer />
  </body>
</html>
