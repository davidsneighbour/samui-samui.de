---
import { getEntry } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';

const entry = await getEntry('pages', 'suche');
if (!entry) throw new Error('Missing pages/suche.md entry');
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description ?? entry.data.title}
>
  <link
    slot="head"
    href="/pagefind/pagefind-ui.css"
    rel="stylesheet"
  >
  <div id="search"></div>
  <script
    slot="scripts"
    is:inline
    src="/pagefind/pagefind-ui.js"
  ></script>
  <script
    slot="scripts"
    is:inline
  >
    window.addEventListener('DOMContentLoaded', () => {
      // biome-ignore lint/correctness/noUndeclaredVariables: loaded globally by the pagefind-ui.js script above
      const search = new PagefindUI({ element: '#search' });
      const query = new URLSearchParams(window.location.search).get('q');
      if (query) search.triggerSearch(query);
    });
  </script>
</PageLayout>
