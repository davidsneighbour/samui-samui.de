---
import { getCollection } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import BlogList from '@components/BlogList.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import {
  getEntityDescription,
  groupPostsByEntity,
  isPublicEntity,
} from '@utils/taxonomies/entities';

export async function getStaticPaths() {
  const [places, posts] = await Promise.all([
    getCollection('orte'),
    getCollection('posts'),
  ]);

  return places.filter(isPublicEntity).map((place) => ({
    params: { slug: place.id },
    props: {
      place,
      posts: groupPostsByEntity(posts, 'orte', place.id),
    },
  }));
}

const { place, posts } = Astro.props;
const description = getEntityDescription('orte', place);
---

<!doctype html>
<html
  lang="de"
  class="dark"
>
  <head>
    <BaseHead
      title={place.data.title}
      description={description}
      noindex={place.data.noindex}
    />
  </head>
  <body>
    <Header />
    <main
      id="main"
      tabindex="-1"
      class="py-8"
    >
      <section>
        <Breadcrumbs
          class="mx-auto max-w-4xl px-4"
          items={[
            { href: '/', label: 'Startseite' },
            { href: '/orte/', label: 'Orte' },
            { href: `/orte/${place.id}/`, label: place.data.title },
          ]}
        />
        <h1
          class="mx-auto mb-4 max-w-4xl px-4 text-2xl font-normal text-foreground"
        >
          {place.data.title}
        </h1>
        <p class="mx-auto mb-8 max-w-4xl px-4 text-muted-foreground">
          {description}
        </p>
        <BlogList
          posts={posts}
          pageNumber={1}
          totalPages={1}
        />
      </section>
    </main>
    <Footer />
  </body>
</html>
