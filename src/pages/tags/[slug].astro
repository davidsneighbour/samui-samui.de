---
import { getCollection } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import BlogList from '@components/BlogList.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import { groupPostsByTag } from '@utils/tags';

export async function getStaticPaths() {
  const [tagEntries, posts] = await Promise.all([
    getCollection('tags'),
    getCollection('posts'),
  ]);

  return groupPostsByTag(posts, tagEntries).map((group) => ({
    params: { slug: group.slug },
    props: {
      description: group.description,
      posts: group.posts.sort(
        (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
      ),
      title: group.title,
    },
  }));
}

const { title, description, posts } = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class="dark"
>
  <head>
    <BaseHead
      title={title}
      description={description}
    />
  </head>
  <body>
    <Header />
    <main class="py-8">
      <section>
        <h1
          class="mx-auto mb-4 max-w-4xl px-4 text-2xl font-normal text-foreground"
        >
          {title}
        </h1>
        <BlogList
          posts={posts}
          pageNumber={1}
          totalPages={1}
        />
      </section>
    </main>
    <Footer />
  </body>
</html>
