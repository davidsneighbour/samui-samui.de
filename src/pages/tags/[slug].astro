---
import { getCollection } from 'astro:content';
import BaseHead from '@components/BaseHead.astro';
import BlogList from '@components/BlogList.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import { humanize, slugify } from '@utils/slugify';

export async function getStaticPaths() {
  const [tagEntries, posts] = await Promise.all([
    getCollection('tags'),
    getCollection('posts'),
  ]);

  // Hugo generates a taxonomy page for every distinct tag *slug* used across
  // posts, not just the ones with a hand-authored _index.md -- that file only
  // provides an optional title/description/slug override for its one term.
  // Front matter `title` on those entries holds the raw (un-prettified) tag
  // string that posts actually reference; `slug` is the pretty URL override.
  const overridesBySlug = new Map(
    tagEntries.map((entry) => [slugify(entry.data.title), entry]),
  );

  // Group by slug, not raw string -- a few posts use inconsistent casing or
  // separators for the same term (e.g. "TAT"/"tat", "bhumibol adulyadej"/
  // "bhumibol-adulyadej"), which must collapse to one page, not collide.
  const bySlug = new Map<string, { rawTag: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const tag of post.data.tags ?? []) {
      const slug = slugify(tag);
      const group = bySlug.get(slug);
      if (group) {
        group.posts.push(post);
      } else {
        bySlug.set(slug, { posts: [post], rawTag: tag });
      }
    }
  }

  return [...bySlug.entries()].map(([slug, { rawTag, posts: tagPosts }]) => {
    const override = overridesBySlug.get(slug);
    const finalSlug = override?.data.slug ?? slug;
    const title = humanize(override?.data.title ?? rawTag);
    const sortedPosts = tagPosts.sort(
      (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
    );

    return {
      params: { slug: finalSlug },
      props: {
        description:
          override?.data.description ?? `Beiträge zum Thema ${title}`,
        posts: sortedPosts,
        title,
      },
    };
  });
}

const { title, description, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
    />
  </head>
  <body>
    <Header />
    <main class="py-8">
      <section>
        <h1
          class="mx-auto mb-4 max-w-4xl px-4 text-2xl font-normal text-foreground"
        >
          {title}
        </h1>
        <BlogList
          posts={posts}
          pageNumber={1}
          totalPages={1}
        />
      </section>
    </main>
    <Footer />
  </body>
</html>
