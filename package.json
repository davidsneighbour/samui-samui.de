{
  "author": {
    "email": "davidsneighbourdev+gh@gmail.com",
    "name": "Patrick Kollitsch",
    "web": "https://davids-neighbour.com"
  },
  "cspell": {
    "import": [
      "./src/config/cspell/cspell.en.jsonc",
      "./src/config/cspell/cspell.de.jsonc"
    ],
    "version": "0.2"
  },
  "dependencies": {
    "@astrojs/react": "5.0.7",
    "@pagefind/default-ui": "1.4.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.1.17",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.25.0",
    "pagefind": "1.5.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sirv": "3.0.2",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.1.17"
  },
  "description": "Website and content for samui-samui.de",
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@biomejs/biome": "2.5.4",
    "@dnbhq/biome-config": "0.2.3",
    "@dnbhq/markdownlint-config": "0.2.8",
    "@dnbhq/release-config": "1.1.0",
    "@iconify-json/bi": "1.2.6",
    "@lucide/astro": "1.25.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@release-it/conventional-changelog": "11.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "astro": "7.1.1",
    "astro-icon": "1.1.5",
    "bootstrap-icons": "1.13.1",
    "cspell": "9.3.2",
    "fixpack": "4.0.0",
    "glob": "13.0.0",
    "lint-staged": "17.0.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "release-it": "20.2.1",
    "sharp": "0.34.5",
    "simple-git-hooks": "2.13.1",
    "typescript": "5.9.3",
    "vite-plugin-mkcert": "2.1.0",
    "wireit": "0.14.12",
    "yaml": "2.9.0"
  },
  "license": "UNLICENSED",
  "lint-staged": {
    "*.{js,cjs,mjs,ts,astro}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{md,mdx}": [
      "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc --fix"
    ],
    "**/!(package-lock).json": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "name": "@davidsneighbour/samui-samui.de",
  "private": true,
  "repository": "davidsneighbour/samui-samui.de",
  "scripts": {
    "astro": "astro",
    "astro:check": "astro check",
    "blog:new": "node src/scripts/new-blog-post.ts",
    "build": "astro check && astro build --verbose",
    "check": "npm run format:check && npm run lint",
    "clean": "wireit",
    "clean:full": "wireit",
    "compile:fixpack": "wireit",
    "compile:package": "wireit",
    "compile:package:install": "wireit",
    "compile:package:update": "wireit",
    "dev": "astro dev --verbose",
    "dev:verbose": "DEBUG_FRONTMATTER=true astro dev --verbose",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "icons:sync": "node src/scripts/create-icon-types.ts",
    "lint": "npm run lint:code && npm run lint:markdown",
    "lint:code": "biome lint .",
    "lint:code:fix": "biome lint --write .",
    "lint:fix": "npm run lint:code:fix && npm run lint:markdown:fix",
    "lint:markdown": "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc \"**/*.{md,mdx}\"",
    "lint:markdown:fix": "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc --fix \"**/*.{md,mdx}\"",
    "lint:spell": "cspell 'src/{*,.*}/**/*.{md,mdx}'",
    "lint:staged": "lint-staged",
    "postinstall:icons": "npm run icons:sync",
    "prepare": "simple-git-hooks",
    "preview": "astro preview",
    "publisher": "node src/scripts/publisher.ts",
    "release": "release-it --config .release-it.ts --ci",
    "release:dry": "release-it --config .release-it.ts --dry-run",
    "release:force": "release-it --config .release-it.ts --ci --no-increment",
    "release:major": "release-it --config .release-it.ts --ci --increment=major",
    "release:minor": "release-it --config .release-it.ts --ci --increment=minor",
    "release:patch": "release-it --config .release-it.ts --ci --increment=patch",
    "upgrade": "npx @astrojs/upgrade"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run check"
  },
  "type": "module",
  "version": "2025.0.0",
  "wireit": {
    "clean": {
      "dependencies": [
        "clean:astro"
      ]
    },
    "clean:astro": {
      "command": "rm -rf .astro dist node_modules/.astro"
    },
    "clean:full": {
      "command": "rm -rf node_modules package-lock.json .wireit",
      "dependencies": [
        "clean:astro"
      ]
    },
    "compile:fixpack": {
      "command": "fixpack --config ci/.fixpackrc.json || true && fixpack --config ci/.fixpackrc.json || true"
    },
    "compile:package": {
      "command": "npm run compile:package:install",
      "dependencies": [
        "compile:package:run"
      ],
      "files": [
        "./src/packages/**/*.jsonc"
      ]
    },
    "compile:package:install": {
      "command": "npm install",
      "dependencies": [
        "compile:fixpack"
      ]
    },
    "compile:package:run": {
      "command": "node ./src/packages/generate-package.ts"
    },
    "compile:package:update": {
      "command": "node ./src/packages/update-package.ts"
    }
  }
}
