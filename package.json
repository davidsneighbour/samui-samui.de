{
  "name": "@davidsneighbour/samui-samui.de",
  "description": "Website and content for samui-samui.de",
  "version": "2.16.0",
  "license": "UNLICENSED",
  "private": true,
  "repository": "https://github.com/davidsneighbour/samui-samui.de.git",
  "author": {
    "email": "davidsneighbourdev+gh@gmail.com",
    "name": "Patrick Kollitsch",
    "web": "https://davids-neighbour.com"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@dnbhq/tsconfig": "0.1.6",
    "@fontsource-variable/anuphan": "5.3.0",
    "@pagefind/component-ui": "1.5.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cuelume": "file:src/vendor/cuelume",
    "lucide": "1.52.0",
    "lucide-react": "1.52.0",
    "maplibre-gl": "6.12.0",
    "morphicons": "1.7.1",
    "pagefind": "1.5.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sirv": "3.0.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@biomejs/biome": "2.5.15",
    "@dnbhq/biome-config": "0.3.1",
    "@dnbhq/markdownlint-config": "2.0.0",
    "@dnbhq/release-config": "2.0.0",
    "@iconify-json/bi": "1.2.7",
    "@iconify-json/simple-icons": "1.2.99",
    "@lucide/astro": "1.52.0",
    "@playwright/mcp": "0.0.83",
    "@playwright/test": "1.63.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/hast": "3.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.3.5",
    "astro-icon": "1.2.0",
    "bootstrap-icons": "1.13.1",
    "cspell": "10.3.6",
    "fixpack": "4.0.0",
    "glob": "13.0.6",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-html": "9.0.5",
    "hastscript": "9.0.1",
    "lint-staged": "17.6.0",
    "lucide-static": "1.52.0",
    "netlify-cli": "27.11.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-raw": "7.0.0",
    "release-it": "21.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.5",
    "simple-git-hooks": "2.14.0",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "vite": "8.3.3",
    "vite-plugin-mkcert": "2.1.0",
    "vitest": "5.0.3",
    "wireit": "0.14.13",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "scripts": {
    "astro": "astro",
    "audit:ahrefs": "node src/scripts/audit/generate.mjs --config src/scripts/audit/ahrefs-audit-sample.config.json",
    "audit:ahrefs:dry": "node src/scripts/audit/generate.mjs --config src/scripts/audit/ahrefs-audit-sample.config.json --dry-run",
    "blog:new": "node src/scripts/new-blog-post.ts",
    "build": "npm run validate && astro build && npm run audit:ahrefs",
    "build:nocache": "PAGEFIND_FORCE_REBUILD=1 npm run build",
    "build:verbose": "npm run validate && astro build --verbose && npm run audit:ahrefs",
    "check": "npm run format:check && npm run lint && npm run validate && npm run test",
    "clean": "wireit",
    "clean:full": "wireit",
    "clean:pagefind": "rm -rf node_modules/.astro/pagefind dist/pagefind",
    "compile:fixpack": "wireit",
    "compile:package": "wireit",
    "compile:package:install": "wireit",
    "compile:package:update": "wireit",
    "covers": "node src/scripts/post-covers.ts",
    "deploy": "node ./src/scripts/deploy.ts",
    "deploy:production": "node ./src/scripts/deploy.ts --production",
    "dev": "node src/scripts/dev.ts",
    "dev:docs": "node src/scripts/documentation-server.ts",
    "dev:site": "astro dev",
    "dev:site:verbose": "astro dev --verbose",
    "dev:verbose": "DEBUG_FRONTMATTER=true ASTRO_SITE_SCRIPT=dev:site:verbose node src/scripts/dev.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "npm run lint:code && npm run lint:markdown && npm run lint:umlauts",
    "lint:code": "biome lint .",
    "lint:code:fix": "biome lint --write .",
    "lint:fix": "npm run lint:code:fix && npm run lint:markdown:fix && npm run lint:umlauts:fix",
    "lint:german-dates": "node src/scripts/lint-german-dates.ts",
    "lint:links": "node src/scripts/lint-links.ts",
    "lint:markdown": "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc \"**/*.{md,mdx}\" \"!CHANGELOG.md\" \"!PROJECT.md\" \"!TODO.md\" \"!RESUME.md\" \"!src/assets/brand/**\"",
    "lint:markdown:fix": "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc --fix \"**/*.{md,mdx}\" \"!CHANGELOG.md\" \"!PROJECT.md\" \"!TODO.md\" \"!RESUME.md\" \"!src/assets/brand/**\"",
    "lint:spell": "cspell 'src/{*,.*}/**/*.{md,mdx}'",
    "lint:staged": "lint-staged",
    "lint:umlauts": "node src/scripts/normalize-german-characters.ts --check",
    "lint:umlauts:fix": "node src/scripts/normalize-german-characters.ts --write",
    "postinstall": "biome migrate --write",
    "prepare": "simple-git-hooks",
    "preview": "astro preview",
    "publisher": "node src/scripts/publisher.ts",
    "release": "release-it --config .release-it.ts --ci",
    "release:dry": "release-it --config .release-it.ts --dry-run",
    "release:force": "release-it --config .release-it.ts --ci --no-increment",
    "release:major": "release-it --config .release-it.ts --ci --increment=major",
    "release:minor": "release-it --config .release-it.ts --ci --increment=minor",
    "release:patch": "release-it --config .release-it.ts --ci --increment=patch",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "thumbnails:fetch": "node src/scripts/content/fetch-video-thumbnails.ts",
    "thumbnails:verify": "node src/scripts/content/fetch-video-thumbnails.ts --verify",
    "upgrade": "npx @astrojs/upgrade",
    "validate": "npm run validate:content && npm run validate:taxonomies",
    "validate:content": "astro check",
    "validate:taxonomies": "node src/scripts/validate-taxonomies.ts"
  },
  "wireit": {
    "compile:fixpack": {
      "command": "fixpack --config ci/.fixpackrc.json || true && fixpack --config ci/.fixpackrc.json || true"
    },
    "compile:package": {
      "command": "npm run compile:package:install",
      "dependencies": [
        "compile:package:run"
      ],
      "files": [
        "./src/packages/**/*.jsonc"
      ]
    },
    "compile:package:install": {
      "command": "npm install",
      "dependencies": [
        "compile:fixpack"
      ]
    },
    "compile:package:run": {
      "command": "node ./src/packages/generate-package.ts"
    },
    "compile:package:update": {
      "command": "node ./src/packages/update-package.ts"
    },
    "clean": {
      "dependencies": [
        "clean:astro"
      ]
    },
    "clean:astro": {
      "command": "rm -rf .astro dist node_modules/.astro"
    },
    "clean:full": {
      "command": "rm -rf node_modules package-lock.json .wireit",
      "dependencies": [
        "clean:astro"
      ]
    }
  },
  "engines": {
    "node": "^26.0.0"
  },
  "cspell": {
    "import": [
      "./src/config/cspell/cspell.en.jsonc",
      "./src/config/cspell/cspell.de.jsonc"
    ],
    "version": "0.2"
  },
  "lint-staged": {
    "src/content/**/*.{md,mdx}": [
      "node src/scripts/lint-links.ts --staged",
      "node src/scripts/lint-german-dates.ts",
      "node src/scripts/content/fetch-video-thumbnails.ts",
      "git add src/assets/images/video-thumbnails"
    ],
    "*.{js,cjs,mjs,ts,astro}": [
      "node src/scripts/normalize-german-characters.ts --write",
      "biome check --write --no-errors-on-unmatched"
    ],
    "**/!(CHANGELOG).{md,mdx}": [
      "node src/scripts/normalize-german-characters.ts --write",
      "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc --fix"
    ],
    "**/!(package|package-lock).json": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "overrides": {
    "@opentelemetry/api": "1.8.0",
    "esbuild": "0.28.1",
    "get-uri": {
      "basic-ftp": "^6.2.1"
    },
    "js-yaml": "5.4.3",
    "markdownlint-rule-title-case-style": {
      "markdownlint": "^0.41.1"
    },
    "release-it": {
      "undici": "^7.29.1"
    },
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "tar": "7.5.22",
    "toml": "4.2.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run validate:content",
    "pre-push": "npm run check"
  },
  "type": "module"
}
